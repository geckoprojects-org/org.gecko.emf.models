  <eClassifiers xsi:type="ecore:EEnum" name="Kindschaftsverhaeltnis">
    <eAnnotations>
      <details key="appinfo" value="&#xA;              &#xA;  &lt;codeliste>&#xA;                   &#xA;    &lt;nameLang>Kindschaftsverhaeltnis&lt;/nameLang>&#xA;                   &#xA;    &lt;nameKurz>Kindschaftsverhaeltnis&lt;/nameKurz>&#xA;                   &#xA;    &lt;nameTechnisch>kindschaftsverhaeltnis&lt;/nameTechnisch>&#xA;                   &#xA;    &lt;kennung>urn:xoev-de:xfamilie:codeliste:kindschaftsverhaeltnis&lt;/kennung>&#xA;                   &#xA;    &lt;beschreibung>Beschreibt das Verhältnis und den Verwandschaftsgrad vom Kind zum Elternteil.&lt;/beschreibung>&#xA;                   &#xA;    &lt;herausgebernameLang>XFamilie&lt;/herausgebernameLang>&#xA;                   &#xA;    &lt;herausgebernameKurz>XFamilie&lt;/herausgebernameKurz>&#xA;                &#xA;  &lt;/codeliste>&#xA;              &#xA;  &lt;versionCodeliste>&#xA;                   &#xA;    &lt;version>1.0&lt;/version>&#xA;                   &#xA;    &lt;beschreibung>[nd]&lt;/beschreibung>&#xA;                   &#xA;    &lt;datumGueltigkeitAb>2022-11-01&lt;/datumGueltigkeitAb>&#xA;                   &#xA;    &lt;versionCodelistenHandbuch>1.2&lt;/versionCodelistenHandbuch>&#xA;                &#xA;  &lt;/versionCodeliste>&#xA;              &#xA;  &lt;codelistenspalten>&#xA;                   &#xA;    &lt;code>&#xA;                        &#xA;      &lt;spaltennameLang>Code&lt;/spaltennameLang>&#xA;                        &#xA;      &lt;datentyp>string&lt;/datentyp>&#xA;                        &#xA;      &lt;codeSpalte>true&lt;/codeSpalte>&#xA;                        &#xA;      &lt;verwendung>required&lt;/verwendung>&#xA;                        &#xA;      &lt;empfohleneCodeSpalte>true&lt;/empfohleneCodeSpalte>&#xA;                     &#xA;    &lt;/code>&#xA;                   &#xA;    &lt;beschreibung>&#xA;                        &#xA;      &lt;datentyp>string&lt;/datentyp>&#xA;                        &#xA;      &lt;codeSpalte>false&lt;/codeSpalte>&#xA;                        &#xA;      &lt;verwendung>required&lt;/verwendung>&#xA;                        &#xA;      &lt;empfohleneCodeSpalte>false&lt;/empfohleneCodeSpalte>&#xA;                     &#xA;    &lt;/beschreibung>&#xA;                &#xA;  &lt;/codelistenspalten>&#xA;           &#xA;"/>
    </eAnnotations>
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
      <details key="name" value="kindschaftsverhaeltnis"/>
    </eAnnotations>
    <eLiterals name="_01" literal="01">
      <eAnnotations>
        <details key="appinfo" value="&#xA;                    &#xA;  &lt;beschreibung>Das Kind ist das leibliche Kind&lt;/beschreibung>&#xA;                 &#xA;"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="_02" value="1" literal="02">
      <eAnnotations>
        <details key="appinfo" value="&#xA;                    &#xA;  &lt;beschreibung>Das Kind ist das Adoptivkind&lt;/beschreibung>&#xA;                 &#xA;"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="_03" value="2" literal="03">
      <eAnnotations>
        <details key="appinfo" value="&#xA;                    &#xA;  &lt;beschreibung>Das Kind steht zu der Person in einem anderen Kindschaftsverhältnis&lt;/beschreibung>&#xA;                 &#xA;"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="_04" value="3" literal="04">
      <eAnnotations>
        <details key="appinfo" value="&#xA;                    &#xA;  &lt;beschreibung>nicht leiblich und nicht rechtlich&lt;/beschreibung>&#xA;                 &#xA;"/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
