        <details key="name" value="sorge.nachweisregister.eintragung.0804"/>
        <details key="namespace" value="##targetNamespace"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="sorgeNachweisregisterKorrektur0805"
        upperBound="-2" eType="#//SorgeNachweisregisterKorrektur0805Type" volatile="true"
        transient="true" derived="true" containment="true" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
