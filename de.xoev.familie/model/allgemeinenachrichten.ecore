    <eLiterals name="T003" value="8">
      <eAnnotations>
        <details key="appinfo" value="&#xA;                    &#xA;  &lt;beschreibung>Das Zertifikat des Absenders fehlt&lt;/beschreibung>&#xA;                 &#xA;"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="T010" value="9">
      <eAnnotations>
        <details key="appinfo" value="&#xA;                    &#xA;  &lt;beschreibung>Die Signatur der Inhaltsdaten fehlt oder hat nicht das geforderte Signaturniveau&lt;/beschreibung>&#xA;                 &#xA;"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="T011" value="10">
      <eAnnotations>
        <details key="appinfo" value="&#xA;                    &#xA;  &lt;beschreibung>Die Signatur der Inhaltsdaten ist nicht gültig (Integrität verletzt)&lt;/beschreibung>&#xA;                 &#xA;"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="T020" value="11">
      <eAnnotations>
        <details key="appinfo" value="&#xA;                    &#xA;  &lt;beschreibung>Die Inhaltsdaten können von dem Empfänger nicht dechiffriert werden&lt;/beschreibung>&#xA;                 &#xA;"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="T070" value="12">
      <eAnnotations>
        <details key="appinfo" value="&#xA;                    &#xA;  &lt;beschreibung>Der Absender ist zur Inanspruchnahme dieses Dienstes nicht berechtigt&lt;/beschreibung>&#xA;                 &#xA;"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="T080" value="13">
      <eAnnotations>
        <details key="appinfo" value="&#xA;                    &#xA;  &lt;beschreibung>Die Nachricht ist dem falschen Empfänger / Leser zugestellt worden, d. h. im Nachrichtenkopf ist eine abweichende Empfängerbehörde eingetragen (Irrläufer)&lt;/beschreibung>&#xA;                 &#xA;"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="T099" value="14">
      <eAnnotations>
        <details key="appinfo" value="&#xA;                    &#xA;  &lt;beschreibung>Sonstiger Verstoß gegen Anforderungen des OSCI-Transport-Profils&lt;/beschreibung>&#xA;                 &#xA;"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="V000" value="15">
      <eAnnotations>
        <details key="appinfo" value="&#xA;                    &#xA;  &lt;beschreibung>Nicht spezifikationskonform: Die Nachricht kann in der Version, die in der Nachricht angegeben wird, vom Empfänger nicht bearbeitet werden (Der Dienst ist in dieser Version nicht oder nicht mehr bereit)&lt;/beschreibung>&#xA;                 &#xA;"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="X000" value="16">
      <eAnnotations>
        <details key="appinfo" value="&#xA;                    &#xA;  &lt;beschreibung>Die Nachricht ist kein wohlgeformtes XML-Dokument&lt;/beschreibung>&#xA;                 &#xA;"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="X001" value="17">
      <eAnnotations>
        <details key="appinfo" value="&#xA;                    &#xA;  &lt;beschreibung>Die Nachricht ist nicht valide zu dem Schema der in der Nachricht angegebenen Version&lt;/beschreibung>&#xA;                 &#xA;"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="X002" value="18">
      <eAnnotations>
        <details key="appinfo" value="&#xA;                    &#xA;  &lt;beschreibung>Die Nachricht ist nicht valide zu den Schematron-Regeln, die für diese Nachricht gelten. Schematron-Fehlercode(s) werden als Unter-Codes mitgeteilt&lt;/beschreibung>&#xA;                 &#xA;"/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
