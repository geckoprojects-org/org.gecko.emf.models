    <eStructuralFeatures xsi:type="ecore:EReference" name="allgemeinenachrichtenQuittung0011"
        upperBound="-2" eType="#//AllgemeinenachrichtenQuittung0011Type" volatile="true"
        transient="true" derived="true" containment="true" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Mit dieser Nachricht quittiert die fachlich zuständige Stelle dem Antragsservice, dass sie eine zuvor erhaltene Nachricht erfolgreich erhalten und auf Spezifikationskonformität geprüft hat und somit aus technische Sicht einer Weiterverarbeitung im Fachverfahren der zuständigen Stelle nichts im Wege steht. Die Quittungsnachricht ist von allen fachlichen Bereichen umzusetzen."/>
      </eAnnotations>
      <eAnnotations>
        <details key="appinfo" value="&#xA;              &#xA;  &lt;rechtsgrundlage>Rechtsgrundlage&lt;/rechtsgrundlage>&#xA;           &#xA;"/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="allgemeinenachrichten.quittung.0011"/>
        <details key="namespace" value="##targetNamespace"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="allgemeinenachrichtenRueckweisung0001"
        upperBound="-2" eType="#//AllgemeinenachrichtenRueckweisung0001Type" volatile="true"
        transient="true" derived="true" containment="true" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Mit dieser Nachricht wird eine an den Leser gerichtete Ursprungsnachricht als fehlerhaft an den Autor zurückgewiesen."/>
      </eAnnotations>
      <eAnnotations>
