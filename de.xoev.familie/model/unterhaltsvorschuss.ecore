  <eClassifiers xsi:type="ecore:EEnum" name="Sonstigeleistungenuv">
    <eAnnotations>
      <details key="appinfo" value="&#xA;              &#xA;  &lt;codeliste>&#xA;                   &#xA;    &lt;nameLang>SonstigeLeistungenUV&lt;/nameLang>&#xA;                   &#xA;    &lt;nameKurz>SonstigeLeistungenUV&lt;/nameKurz>&#xA;                   &#xA;    &lt;nameTechnisch>sonstigeleistungenuv&lt;/nameTechnisch>&#xA;                   &#xA;    &lt;kennung>urn:xoev-de:xfamilie:codeliste:sonstigeleistungenuv&lt;/kennung>&#xA;                   &#xA;    &lt;beschreibung>Die Liste codiert die unterschiedlichen Sozial-, Familien- und Entgeltersatzleistungen, die auf die zu beantragenden Leistungen angerechnet werden. Diese Codeliste wurde speziell für Unterhaltsvorschuss angelegt und sollte mit der Codelist.SonstigeLeistungen harmonisiert werden.&lt;/beschreibung>&#xA;                   &#xA;    &lt;herausgebernameLang>XFamilie&lt;/herausgebernameLang>&#xA;                   &#xA;    &lt;herausgebernameKurz>XFamilie&lt;/herausgebernameKurz>&#xA;                &#xA;  &lt;/codeliste>&#xA;              &#xA;  &lt;versionCodeliste>&#xA;                   &#xA;    &lt;version>1.0&lt;/version>&#xA;                   &#xA;    &lt;beschreibung>[nd]&lt;/beschreibung>&#xA;                   &#xA;    &lt;datumGueltigkeitAb>2022-11-01&lt;/datumGueltigkeitAb>&#xA;                   &#xA;    &lt;versionCodelistenHandbuch>1.2&lt;/versionCodelistenHandbuch>&#xA;                &#xA;  &lt;/versionCodeliste>&#xA;              &#xA;  &lt;codelistenspalten>&#xA;                   &#xA;    &lt;code>&#xA;                        &#xA;      &lt;spaltennameLang>Code&lt;/spaltennameLang>&#xA;                        &#xA;      &lt;datentyp>string&lt;/datentyp>&#xA;                        &#xA;      &lt;codeSpalte>true&lt;/codeSpalte>&#xA;                        &#xA;      &lt;verwendung>required&lt;/verwendung>&#xA;                        &#xA;      &lt;empfohleneCodeSpalte>true&lt;/empfohleneCodeSpalte>&#xA;                     &#xA;    &lt;/code>&#xA;                   &#xA;    &lt;beschreibung>&#xA;                        &#xA;      &lt;datentyp>string&lt;/datentyp>&#xA;                        &#xA;      &lt;codeSpalte>false&lt;/codeSpalte>&#xA;                        &#xA;      &lt;verwendung>required&lt;/verwendung>&#xA;                        &#xA;      &lt;empfohleneCodeSpalte>false&lt;/empfohleneCodeSpalte>&#xA;                     &#xA;    &lt;/beschreibung>&#xA;                &#xA;  &lt;/codelistenspalten>&#xA;           &#xA;"/>
    </eAnnotations>
