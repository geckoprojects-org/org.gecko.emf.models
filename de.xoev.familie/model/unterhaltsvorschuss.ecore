  <eClassifiers xsi:type="ecore:EClass" name="AnschriftOptionalType">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Daten zur Anschrift. Da beim Unterhaltsvorschuss die antragstellende Person Angaben zum anderen Elternteil machen soll und davon ausgegangen werden muss, dass die Angaben unvollständig sein werden, sind alle Angaben der Anschrift optional."/>
    </eAnnotations>
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
      <details key="name" value="Anschrift.optionalType"/>
      <details key="kind" value="elementOnly"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="hausnummer" eType="ecore:EDataType baukasten.ecore#//MeldeanschriftHausnummerType">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Es sind nur die Ziffern einer Hausnummer anzugeben."/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="hausnummer"/>
