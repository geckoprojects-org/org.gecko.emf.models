        defaultValueLiteral="true" unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Jedes nachnutzende Land und jede nachnutzende Kommune muss neben der Datenschutzerklärung des betreibenden Landes noch eine eigene Datenschutzerklärung erstellen. Diese muss verpflichtend bestätigt werden."/>
      </eAnnotations>
