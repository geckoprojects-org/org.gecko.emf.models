   <xs:element name="elterngeldantrag.antrag.0201">
      <xs:annotation>
         <xs:appinfo>
            <rechtsgrundlage>Gesetz zum Elterngeld und zur Elternzeit (Bundeselterngeld- und Elternzeitgesetz - BEEG)</rechtsgrundlage>
         </xs:appinfo>
         <xs:documentation>Nachricht vom Portal an die Elterngeldstelle für einen Elterngeldantrag</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xfb:AntragsnachrichtType">
               <xs:sequence>
                  <xs:element name="kind" type="xfe:Kind.ElterngeldType">
                     <xs:annotation>
                        <xs:documentation>Daten zum Kind oder den Kindern, für die Elterngeld beantragt wird.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="elterngeldantrag" type="xfe:Code.ElterngeldantragType">
                     <xs:annotation>
                        <xs:documentation>Daten dazu, welche Elternteile den Antrag stellen.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="gesamteinkommen" type="xfe:Code.GesamteinkommenType">
                     <xs:annotation>
                        <xs:documentation>Daten zum Gesamteinkommen im letzten steuerlichen Veranlagungszeitraum der Elternteile.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="elternteilEins" type="xfe:ElternteilEins.ElterngeldantragType">
                     <xs:annotation>
                        <xs:documentation>Daten zum Elternteil, der Elterngeld beantragt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="elternteilZwei"
                              minOccurs="0"
                              type="xfe:ElternteilZwei.ElterngeldantragType">
                     <xs:annotation>
                        <xs:documentation>Daten zum zweiten Elternteil. Diese Angaben sind optional, da auch ein einzelner Elternteil den Antrag stellen kann.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="mutterschaftsgeldArbeitgeberzuschussVglLeistungen"
                              type="xfe:MutterschaftsgeldArbeitgeberzuschussVergleichbareLeistungenType">
                     <xs:annotation>
                        <xs:documentation>Daten zu Mutterschaftsgeld, Arbeitgeberzuschuss und vergleichbaren Leistungen.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="weitereKinderImHaushalt" type="xfe:WeitereKinderType">
                     <xs:annotation>
                        <xs:documentation>Angaben zu weiteren Kindern im Haushalt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="nachweisdokument.antragsservice"
                              minOccurs="0"
                              maxOccurs="unbounded"
                              type="xfb:NachweisdokumentType">
                     <xs:annotation>
                        <xs:documentation>Vom Antragsservice selbst erstellte Nachweisdokumente zur Ablage in der Akte der Fachbehörde. Beispiel: Die Willenserklärung eines oder der Antragstellenden "im Original".</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="pdfAntrag"
                              minOccurs="0"
                              maxOccurs="unbounded"
                              type="xfb:NachweisdokumentType"/>
                  <xs:element name="nachweisdokument.antragsteller"
                              minOccurs="0"
                              maxOccurs="unbounded"
                              type="xfb:NachweisdokumentType">
                     <xs:annotation>
                        <xs:documentation>Von den Antragstellenden im Antragsservice bereitgestellte Nachweisdokumente (hochgeladene Fotos, Scans, etc.).</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="datenabruf"
                              minOccurs="0"
                              maxOccurs="unbounded"
                              type="xfb:DatenabrufType"/>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="elterngeldantrag.vorabmeldung.0202">
      <xs:annotation>
         <xs:appinfo>
            <rechtsgrundlage>Gesetz zum Elterngeld und zur Elternzeit (Bundeselterngeld- und Elternzeitgesetz - BEEG)</rechtsgrundlage>
         </xs:appinfo>
         <xs:documentation>Die Vorabmeldung dient der Informierung der zuständige Stelle über einen Eingang eines Elterngeldantrags im Portal oder Antragsservice.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xfb:AntragsnachrichtType">
               <xs:sequence>
                  <xs:element name="antragstellenerElternteil.Vorabmeldung"
                              maxOccurs="2"
                              type="xfe:AntragstellenderElternteil.VorabmeldungType">
                     <xs:annotation>
                        <xs:documentation>Grunddaten zum antragstellenden Elternteil, die der Identifizierung des antragstellenden Elternteils durch die zuständigen Stelle dienen.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="angabenKind.Vorabmeldung" type="xfe:Kind.VorabmeldungType">
                     <xs:annotation>
                        <xs:documentation>Daten zum Kind oder den Kindern, für die Elterngeld beantragt wird.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="antragsdokumente"
                              minOccurs="0"
                              maxOccurs="unbounded"
                              type="xfb:NachweisdokumentType">
                     <xs:annotation>
                        <xs:documentation>Hier können “Antragsdokumente” mitgeliefert werden. Dies können neben dem eigentlichen Elterngeldantrag (PDF und XML) auch vom Nutzer hochgeladene Dokumente sein.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="elterngeldantrag.standesamtsmeldung.0203">
      <xs:annotation>
         <xs:appinfo>
            <rechtsgrundlage>Gesetz zum Elterngeld und zur Elternzeit (Bundeselterngeld- und Elternzeitgesetz - BEEG)</rechtsgrundlage>
         </xs:appinfo>
         <xs:documentation>Die Ankündigung, dass die Geburtsurkunde durch ELFE beim Standesamt angefordert wurde, erfolgt anhand einer XML-Datei.</xs:documentation>
