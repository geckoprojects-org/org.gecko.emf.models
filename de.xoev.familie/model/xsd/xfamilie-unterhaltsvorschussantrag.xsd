         <xs:element name="name" type="xfu:Name.OptionalType">
            <xs:annotation>
               <xs:documentation>Der Name des antragstellenden Elternteils.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="geburt" minOccurs="0" type="xfb:Geburt.NachweisbezugType">
            <xs:annotation>
               <xs:documentation>Daten zur Geburt des antragstellenden Elternteils.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="anrede" minOccurs="0" type="din91379:datatypeC">
            <xs:annotation>
               <xs:documentation>Die Anrede des antragstellenden Elternteils. Diese kann frei gewählt werden.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="kindschaftsbeziehung"
                     minOccurs="0"
                     type="xfb:Code.KindschaftsbeziehungType">
            <xs:annotation>
               <xs:documentation>Die Kindschaftsbeziehung gibt das Verhältnis zwischen dem antragstellendem Elternteil und dem Antragskind an. Hinweis: In späteren Versionen soll dieses Element die informationen von dem Element "Elternschaft" mitabbilden.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="anschrift"
                     type="xfb:PostalischeInlandsanschrift.Gebaeudeanschrift.NachweisbezugType">
            <xs:annotation>
               <xs:documentation>Die Anschrift des antragstellenden Elternteils.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="aufenthaltstitelEAT"
                     minOccurs="0"
                     maxOccurs="unbounded"
                     type="xfb:Aufenthaltstitel.NachweisbezugType">
            <xs:annotation>
               <xs:documentation>Datum zum elektronischen Aufenthaltstitel. Regel: Muss genutzt werden, falls der Aufenthaltstitel nicht hochgeladen wird, sondern der eAT (elektronische Aufenhaltstitel) genutzt wird.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="aufenthaltstitelUpload"
                     minOccurs="0"
                     maxOccurs="unbounded"
                     type="xfb:UUIDType">
            <xs:annotation>
               <xs:documentation>Hier erfolgt mittels Angabe einer UUID die Referenz auf die zugehörige Nachricht vom Typ nachweisnachricht.0311; es ist deren Element nachrichtenUUID anzugeben. Hier wird zusätzlich die Möglichkeit gegeben mehrere UUID pro Nachweis zu vergeben, da es sein kann, dass ein Nachweis in mehreren Nachrichten der nachweisnachricht.0311 geschickt werden. Der hier gemeinte Nachweis ist ein Aufenthaltstitel. Regel: Falls Staatsangehoerigkeit des antragstellenden Elternteil nicht "Deutsch" oder "Schweiz/EU/EWR" ist und nicht der eAT (elektronische Aufenhaltstitel) genutzt wird.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="familienstand" type="xfu:Familienstand.BasisType">
            <xs:annotation>
               <xs:documentation>Der Familienstand und die Lebenssituation des antragstellenden Elternteils.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="erreichbarkeit"
                     minOccurs="0"
                     maxOccurs="unbounded"
                     type="xfb:ErreichbarkeitType">
            <xs:annotation>
               <xs:documentation>Daten zur Erreichbarkeit über Kommunikationskanäle.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="bankverbindung" minOccurs="0" type="xfb:BankverbindungType">
            <xs:annotation>
               <xs:documentation>Daten zur Bankverbindung Hinweis: Antragsfälle ohne Bankverbindung werden durch XFamilie in der aktuellen Fassung nicht unterstützt.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="staatsangehoerigkeit"
                     minOccurs="0"
                     type="xfu:StaatsangehoerigkeitType">
            <xs:annotation>
               <xs:documentation>Die Staatsangehörigkeiten des antragstellenden Elternteils. Regel: Bei mehreren Staatsangehörigkeiten einer Person ist immer Deutsch/Schweiz/EU/EWR zu übertragen, wenn eine dieser besteht, ansonsten sonstiges. Hinweis: verpflichtend für den Antrag (0301) anzugeben.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="einkommensgrenzeErfuellt" minOccurs="0" type="xs:boolean">
            <xs:annotation>
               <xs:documentation>Datum zur Einkommensgrenze. Regel: Falls das Antragskind das 12. Lebensjahr abgeschlossen hat und das Kind Leistungen nach SGB II bezieht.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="postAdresse"
                     minOccurs="0"
                     type="xfb:PostalischeInlandsanschrift.BasisType">
            <xs:annotation>
               <xs:documentation>Daten zur Postadresse. Es gibt Fälle, in denen die Meldeadresse im Personalausweis nicht die postalische Adresse sein soll. Regel: Nur auszufüllen, wenn die Bescheide der UV Stelle nicht an die Meldeanschrift gesendet werden sollen.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="vertretung"
                     minOccurs="0"
                     maxOccurs="unbounded"
                     type="xfu:VertretungType">
            <xs:annotation>
               <xs:documentation>Daten zur Vertretung des antragstellenden Elternteils.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="zukuenftigeAdresse"
                     minOccurs="0"
                     type="xfb:PostalischeInlandsanschrift.BasisType">
            <xs:annotation>
               <xs:documentation>Daten zur zukünftigen Adresse. Es gibt Fälle, in denen die Meldeadresse im Personalsausweis veraltet ist oder bald veraltet sein wird. Regel: Falls die Meldeanschrift im Personalausweis veraltet ist, kann hiermit die korrekte Adresse angegeben werden.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="zukuenftigeAdresseAb" minOccurs="0" type="xfb:TagesdatumType">
            <xs:annotation>
               <xs:documentation>Datum, ab dem die zukünftige Adresse gilt. Regel: verpflichtend anzugeben, wenn eine zukünftige Adresse angegeben wurde.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="zukuenftigeAdresseMitAnderemElternteil"
                     minOccurs="0"
                     type="xs:boolean">
            <xs:annotation>
               <xs:documentation>Angabe, ob an der zukünftigen Adresse auch das andere Elternteil wohnhaft sein wird. Regel: verpflichtend anzugeben, wenn eine zukünftige Adresse angegeben wurde.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="zukuenftigeAdresseMitAnderemElternteilAb"
                     minOccurs="0"
                     type="xfb:TagesdatumType">
            <xs:annotation>
               <xs:documentation>Datum, ab dem die zukünftige Adresse mit dem anderen Elternteil gilt. Regel: verpflichtend anzugeben, wenn eine zukünftige Adresse angegeben wurde.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="nameNachweis" minOccurs="0" type="xfb:NachweisbezugType"/>
         <xs:element name="lohnsteuerklasse"
                     minOccurs="0"
                     type="xfu:LohnsteuerklasseType">
            <xs:annotation>
               <xs:documentation>Angaben zur Lohnsteuerklasse.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="geschlecht" minOccurs="0" type="xfb:Code.GeschlechtType">
            <xs:annotation>
               <xs:documentation>In Bereich UVG müssen Statistiken abgegeben werden, die sich auch auf das Geschlecht des Antragsteller beziehen.</xs:documentation>
            </xs:annotation>
         </xs:element>
      </xs:sequence>
   </xs:complexType>
