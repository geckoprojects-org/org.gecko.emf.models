                  </xs:annotation>
               </xs:element>
               <xs:element name="andereRegelmaessigerAufenthaltort"
                           minOccurs="0"
                           type="xfb:TatsacheMitFreitextType">
                  <xs:annotation>
                     <xs:documentation>Daten zum anderen regelmäßigen Aufenthaltsort des anderen Elternteils. Regel: Falls bekannt ist, dass der andere Elternteil sich häufig nicht an seiner Anschrift aufhält.</xs:documentation>
                  </xs:annotation>
               </xs:element>
               <xs:element name="erreichbarkeit"
                           minOccurs="0"
                           maxOccurs="unbounded"
                           type="xfb:ErreichbarkeitType">
                  <xs:annotation>
                     <xs:documentation>Angaben zur Erreichbarkeit über elektronische Kommunikationskanäle.</xs:documentation>
                  </xs:annotation>
               </xs:element>
               <xs:element name="einkuenfte"
                           maxOccurs="unbounded"
                           type="xfu:Einkuenfte.AndererElternteilType">
                  <xs:annotation>
                     <xs:documentation>Daten zu Einkünften des anderen Elternteils.</xs:documentation>
                  </xs:annotation>
               </xs:element>
               <xs:element name="weitereAngaben"
                           minOccurs="0"
                           type="xfb:TatsacheMitFreitextType">
                  <xs:annotation>
                     <xs:documentation>Weitere Angaben zum anderen Elternteil.</xs:documentation>
                  </xs:annotation>
               </xs:element>
            </xs:sequence>
         </xs:restriction>
      </xs:complexContent>
   </xs:complexType>
