   <xs:annotation>
      <xs:appinfo>
         <standard>
            <nameLang>XFamilie</nameLang>
            <nameKurz>XFamilie</nameKurz>
            <nameTechnisch>xfamilie</nameTechnisch>
            <kennung>urn:xoev-de:kosit:standard:xfamilie</kennung>
            <beschreibung>Projektziel ist die elektronische Kommunikation im Familienbereich zwischen verschiedenen Behörden, Institutionen, Registern und Onlineportalen, die Daten untereinander austauschen, zu unterstützen. Der Nutzen des Projekts besteht in der Kostenreduktion und einer Verbesserung der Qualität von Daten für Familienleistungen, sowie einer Verbesserung der Interoperabilität von Akteuren im Familienbereich und weiteren Kommunikationspartner.</beschreibung>
         </standard>
         <versionStandard>
            <version>1.3.0</version>
            <beschreibung>Die Änderungshistorie befindet sich in Tabellenform nach Change Requests gegliedert in Kapitel E.</beschreibung>
            <versionXOEVProfil>3.0.2</versionXOEVProfil>
            <versionXOEVHandbuch>3.0.2</versionXOEVHandbuch>
            <versionXGenerator>3.1.0</versionXGenerator>
            <versionModellierungswerkzeug>19.0</versionModellierungswerkzeug>
            <nameModellierungswerkzeug>MagicDraw</nameModellierungswerkzeug>
         </versionStandard>
      </xs:appinfo>
   </xs:annotation>
   <xs:import schemaLocation="din-norm-91379-datatypes.xsd"
              namespace="urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08"/>
   <xs:import schemaLocation="xfamilie-baukasten.xsd"
              namespace="http://www.xoev.de/xfamilie/baukasten/1.3.0"/>
   <xs:import schemaLocation="xoev-code.xsd"
              namespace="http://xoev.de/schemata/code/1_0"/>
   <xs:complexType name="AmtspflegendeType">
      <xs:annotation>
         <xs:documentation>Daten zur Amtspflegschaft.</xs:documentation>
      </xs:annotation>
      <xs:sequence>
         <xs:element name="name" type="xfb:NameNatuerlichePersonType">
            <xs:annotation>
               <xs:documentation>Name der Person, die verantwortlich für die Pflege ist.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="anschriftJugendamt"
                     minOccurs="0"
                     type="xfb:PostalischeInlandsanschrift.BasisType">
            <xs:annotation>
               <xs:documentation>Daten zur Anschrift des Jugendamtes, dessen Teil der Beistand ist.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="jugendamtEMail" minOccurs="0" type="din91379:datatypeC">
            <xs:annotation>
               <xs:documentation>E-Mail-Kontakt des Jugendamts, bei dem die Amtspflegschaft besteht.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="aktenzeichen" type="din91379:datatypeC">
            <xs:annotation>
               <xs:documentation>Aktenzeichen der Amtspflegschaft beim Jugendamt.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="beauftragtGeltungsmachungUVanspruch" type="xs:boolean">
            <xs:annotation>
               <xs:documentation>Datum zur Beauftragung der Geltungsmachung von Unterhaltsansprüchen.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="telefonnummer" type="din91379:datatypeC">
            <xs:annotation>
               <xs:documentation>Telefonnummer des Jugendamts, bei dem die Amtspflegschaft besteht.</xs:documentation>
            </xs:annotation>
         </xs:element>
      </xs:sequence>
   </xs:complexType>
   <xs:complexType name="AnderePersonType">
      <xs:annotation>
         <xs:documentation>Information zu einer anderen Person, bei der der Unterhaltstitel liegt.</xs:documentation>
      </xs:annotation>
      <xs:sequence>
         <xs:element name="name" type="xfb:NameNatuerlichePersonType">
            <xs:annotation>
               <xs:documentation>Name der anderen Person.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="anschrift" type="xfu:Anschrift.optionalType">
            <xs:annotation>
               <xs:documentation>Anschrift der anderen Person.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="bezeichnung" minOccurs="0" type="din91379:datatypeC">
            <xs:annotation>
               <xs:documentation>Hier wird genauer beschrieben, wo der Unterhaltstitel liegt. Es kann auch eine Institution sein.</xs:documentation>
            </xs:annotation>
         </xs:element>
      </xs:sequence>
   </xs:complexType>
   <xs:complexType name="AndererElternteil.BasisType">
      <xs:annotation>
         <xs:documentation>Daten zum anderen Elternteil.</xs:documentation>
      </xs:annotation>
      <xs:sequence>
         <xs:element name="name" minOccurs="0" type="xfu:Name.OptionalType">
            <xs:annotation>
               <xs:documentation>Der Name des anderen Elternteils</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="geburt" minOccurs="0" type="xfb:GeburtType">
            <xs:annotation>
               <xs:documentation>Daten zur Geburt des anderen Elternteils.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="anrede" minOccurs="0" type="din91379:datatypeC">
            <xs:annotation>
               <xs:documentation>Die Anrede des anderen Elternteils. Diese kann frei gewählt werden.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="kindschaftsbeziehung"
                     minOccurs="0"
                     type="xfb:Code.KindschaftsbeziehungType">
            <xs:annotation>
               <xs:documentation>Die Kindschaftsbeziehung gibt das Verhältnis zwischen dem anderen Elternteil und dem Antragskind an. Hinweis: In späteren Versionen soll dieses Element die informationen von dem Element "Elternschaft" mitabbilden.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="anschrift" minOccurs="0" type="xfu:Anschrift.optionalType">
            <xs:annotation>
               <xs:documentation>Die Anschrift des anderen Elternteils</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="andereRegelmaessigerAufenthaltort"
                     minOccurs="0"
                     type="xfb:TatsacheMitFreitextType">
            <xs:annotation>
               <xs:documentation>Daten zum anderen regelmäßigen Aufenthaltsort des anderen Elternteils. Regel: Falls bekannt ist, dass der andere Elternteil sich häufig nicht an seiner Anschrift aufhält.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="staatsangehoerigkeit"
                     minOccurs="0"
                     type="xfu:Staatsangehoerigkeit.andererElternteilType">
            <xs:annotation>
               <xs:documentation>Die Staatsangehörigkeiten des anderen Elternteils. Regel: Bei mehreren Staatsangehörigkeiten einer Person ist immer Deutsch/Schweiz/EU/EWR zu übertragen, wenn eine dieser besteht, ansonsten Sonstiges.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="zusammenlebendMitNeuenPartner"
                     minOccurs="0"
                     type="xfb:Code.TatsachenbehauptungType">
            <xs:annotation>
               <xs:documentation>Hier können Informationen zur Lebenssituation des anderen Elternteils übertragen werden. Lebt der andere Elternteil mit neuem Partner oder neuer Partnerin zusammen.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="erreichbarkeit"
                     minOccurs="0"
                     maxOccurs="unbounded"
                     type="xfb:ErreichbarkeitType">
            <xs:annotation>
               <xs:documentation>Angaben zur Erreichbarkeit über elektronische Kommunikationskanäle.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="vertretung"
                     minOccurs="0"
                     maxOccurs="unbounded"
                     type="xfu:VertretungType">
            <xs:annotation>
               <xs:documentation>Daten zur Vertretung des anderen Elternteils.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="vermoegen"
                     minOccurs="0"
                     maxOccurs="unbounded"
                     type="xfu:Vermoegen.andererElternteilType">
            <xs:annotation>
               <xs:documentation>Daten zum Vermögen des anderen Elternteils.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="einkuenfte"
                     maxOccurs="unbounded"
                     type="xfu:Einkuenfte.AndererElternteilType">
            <xs:annotation>
               <xs:documentation>Daten zu Einkünften des anderen Elternteils.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="sonstigeLeistungen"
                     minOccurs="0"
                     maxOccurs="unbounded"
                     type="xfu:SonstigeLeistung.andererElternteilType">
            <xs:annotation>
               <xs:documentation>Daten zu sonstigen Leistungen des anderen Elternteils.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="traegerKrankenversicherung"
                     minOccurs="0"
                     type="xfu:TraegerKrankenversicherungType">
            <xs:annotation>
               <xs:documentation>Daten zum Krankenversicherungsträger des anderen Elternteils.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="weitereKinder"
                     minOccurs="0"
                     maxOccurs="unbounded"
                     type="xfu:WeitereKinder.AndererElternteilType">
            <xs:annotation>
               <xs:documentation>Daten zu weiteren nicht gemeinsamen Kindern des anderen Elternteils.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="ausbildung"
                     minOccurs="0"
                     maxOccurs="unbounded"
                     type="xfu:Ausbildung.andererElternteilType">
            <xs:annotation>
               <xs:documentation>Daten zur Ausbildung des anderen Elternteils.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="leistungsfaehig" minOccurs="0" type="din91379:datatypeC">
            <xs:annotation>
               <xs:documentation>Daten mit bekannten Informationen und Gründen für eine bestehende oder nicht bestehende Leistungsfähigkeit des anderen Elternteils.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="weitereAngaben"
                     minOccurs="0"
                     type="xfb:TatsacheMitFreitextType">
            <xs:annotation>
               <xs:documentation>Weitere Angaben zum anderen Elternteil.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="geschlecht" minOccurs="0" type="xfb:Code.GeschlechtType">
            <xs:annotation>
               <xs:documentation>In Bereich UVG müssen Statistiken abgegeben werden, die sich auch auf das Geschlecht des Antragsteller beziehen.</xs:documentation>
            </xs:annotation>
         </xs:element>
      </xs:sequence>
   </xs:complexType>
   <xs:complexType name="AndererElternteil.UeberpruefungType">
