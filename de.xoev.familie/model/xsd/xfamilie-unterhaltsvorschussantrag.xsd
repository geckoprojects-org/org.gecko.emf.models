            <rechtsgrundlage>Unterhaltsvorschussgesetz</rechtsgrundlage>
         </xs:appinfo>
         <xs:documentation>Nachricht vom Portal an die Unterhaltsvorschussstelle für einen Antrag eines Elternteils auf Unterhaltsvorschuss für ein Kind.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
