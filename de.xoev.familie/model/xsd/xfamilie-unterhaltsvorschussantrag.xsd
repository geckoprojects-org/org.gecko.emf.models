   <xs:complexType name="AngabenKind.NachreichenType">
      <xs:annotation>
         <xs:documentation>Angaben zum Kind, die beim Nachreichen von Informationen gemacht werden müssen.</xs:documentation>
      </xs:annotation>
      <xs:sequence>
         <xs:element name="name" type="xfu:Name.MitGeburtsnameType">
            <xs:annotation>
               <xs:documentation>Der Name des Antragskindes.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="geburt" type="xfb:GeburtGeburtsortOptionalType">
            <xs:annotation>
               <xs:documentation>Daten zur Geburt des Kindes.</xs:documentation>
            </xs:annotation>
         </xs:element>
