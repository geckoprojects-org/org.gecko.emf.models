                     <xs:annotation>
                        <xs:documentation>Hiermit werden die Daten zum antragstellenden Elternteil übertragen.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="andererElternteil"
                              minOccurs="0"
                              type="xfu:AndererElternteilType">
                     <xs:annotation>
                        <xs:documentation>Hiermit werden die Daten zum anderen Elternteil übertragen.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="weitereGemeinsameKinder"
                              minOccurs="0"
                              maxOccurs="unbounded"
                              type="xfu:WeitereGemeinsameKinderType">
                     <xs:annotation>
                        <xs:documentation>Hiermit werden die Daten zu weiteren gemeinsamen Kindern übertragen.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="elternschaft" minOccurs="0" type="xfu:ElternschaftType">
                     <xs:annotation>
                        <xs:documentation>Hiermit werden Daten zur Vaterschaft übertragen.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="unterhalt" type="xfu:UnterhaltType">
                     <xs:annotation>
                        <xs:documentation>Hiermit werden Daten zum Unterhalt übertragen.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="datenabruf" minOccurs="0" type="xfb:DatenabrufType"/>
