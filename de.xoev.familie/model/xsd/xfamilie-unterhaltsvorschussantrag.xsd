                  <xs:annotation>
                     <xs:documentation>Daten zur Geburt des anderen Elternteils.</xs:documentation>
                  </xs:annotation>
               </xs:element>
               <xs:element name="anrede" minOccurs="0" type="din91379:datatypeC">
                  <xs:annotation>
                     <xs:documentation>Die Anrede des anderen Elternteils. Diese kann frei gewählt werden.</xs:documentation>
                  </xs:annotation>
               </xs:element>
               <xs:element name="kindschaftsbeziehung"
