   <xs:element name="unterhaltsvorschussantrag.JaehrlicheUeberpruefung.0302">
      <xs:annotation>
         <xs:appinfo>
            <rechtsgrundlage>Unterhaltsvorschussgesetz</rechtsgrundlage>
         </xs:appinfo>
         <xs:documentation>Nachricht vom Portal an die Unterhaltsvorschussstelle für die jährliche Überprüfung des Antrags eines Elternteils auf Unterhaltsvorschuss für ein Kind.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xfb:AntragsnachrichtType">
               <xs:sequence>
                  <xs:element name="gesamtZahlDerNachrichten" type="xs:nonNegativeInteger">
                     <xs:annotation>
                        <xs:documentation>Hiermit wird die Gesamtzahl der zu erwartenden Nachrichten übersandt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="antragskind" type="xfu:Antragskind.UeberpruefungType">
                     <xs:annotation>
                        <xs:documentation>Hiermit werden die Daten zum Antragskind übertragen.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="antragstellenderElternteil"
                              type="xfu:AntragstellenderElternteil.UeberpruefungType">
                     <xs:annotation>
                        <xs:documentation>Hiermit werden die Daten zum antragstellenden Elternteil übertragen.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="andererElternteil"
                              minOccurs="0"
                              type="xfu:AndererElternteil.UeberpruefungType">
                     <xs:annotation>
                        <xs:documentation>Hiermit werden die Daten zum anderen Elternteil übertragen.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="unterhalt" type="xfu:Unterhalt.UeberpruefungType">
                     <xs:annotation>
                        <xs:documentation>Hiermit werden Daten zum Unterhalt übertragen.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="datenabruf" minOccurs="0" type="xfb:DatenabrufType"/>
                  <xs:element name="pdfAntrag" minOccurs="0" type="xfb:NachweisdokumentType"/>
                  <xs:element name="wartenAufUnterschrift" type="xs:boolean"/>
                  <xs:element name="dsgvo" type="xfb:DatenschutzerklaerungenType">
                     <xs:annotation>
                        <xs:documentation>Bestätigung zur Datenschutzerklärung des Dienst-betreibenden Landes sowie zur spezifischen Datenschutzerklärung des nachnutzenden Landes oder der nachnutzenden Kommune.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="artSignaturDigital" minOccurs="0" type="xs:boolean">
                     <xs:annotation>
                        <xs:documentation>Pro Antrag wird hinterlegt, welche Art der Signatur (digital oder mit Unterschriften-Seite) gewählt wurde. Beim Wert "true" handelt es sich um eine digitale Sigantur. Es ist wichtig für die Sachbearbeitung, dass im Fachverfahren eingesehen werden kann, wie der Antrag unterschrieben wurde, um bei digitaler Signatur die Bearbeitung direkt beginnen zu können oder ggf. auf den postalischen Mantelbogen zu warten.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="bestaetigungAngaben"
                              minOccurs="0"
                              type="xfu:BestaetigungAngabenType"/>
                  <xs:element name="merkblattUVG" minOccurs="0" type="xs:boolean">
                     <xs:annotation>
                        <xs:documentation>Dokumentiert die Kenntnisnahme und Bestätigung des UVG Merkblatts.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="unterhaltsvorschussantrag.nachreichen.0303">
      <xs:annotation>
         <xs:appinfo>
            <rechtsgrundlage>Unterhaltsvorschussgesetz</rechtsgrundlage>
         </xs:appinfo>
         <xs:documentation>Nachricht zum Nachreichen von Informationen für einen Unterhaltsvorschussantrag.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xfb:AntragsnachrichtType">
               <xs:sequence>
                  <xs:element name="fallnummerUVO" minOccurs="0" type="din91379:datatypeC">
                     <xs:annotation>
                        <xs:documentation>UVO-Bearbeitungs- bzw. -Fallnummer, auf die sich die Nachreichung bezieht.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="angabenKindNachreichen" type="xfu:AngabenKind.NachreichenType">
                     <xs:annotation>
                        <xs:documentation>Angaben zum Kind, die beim Nachreichen von Informationen gemacht werden müssen.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="aenderungsmitteilung" minOccurs="0" type="din91379:datatypeC">
                     <xs:annotation>
                        <xs:documentation>Freitextfeld für eine Änderungsmitteilung durch den/die Antragsteller:in.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="nachzureichendesDokument"
                              minOccurs="0"
                              maxOccurs="unbounded"
                              type="xfb:NachweisdokumentType">
                     <xs:annotation>
                        <xs:documentation>Dokumentenupload (bspw. nachgereichte Nachweise).</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="dsgvo" type="xfb:DatenschutzerklaerungenType">
                     <xs:annotation>
                        <xs:documentation>Bestätigung zur Datenschutzerklärung des Dienst-betreibenden Landes sowie zur spezifischen Datenschutzerklärung des nachnutzenden Landes oder der nachnutzenden Kommune.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="artSignaturDigital" minOccurs="0" type="xs:boolean">
                     <xs:annotation>
                        <xs:documentation>Pro Antrag wird hinterlegt, welche Art der Signatur (digital oder mit Unterschriften-Seite) gewählt wurde. Beim Wert "true" handelt es sich um eine digitale Sigantur. Es ist wichtig für die Sachbearbeitung, dass im Fachverfahren eingesehen werden kann, wie der Antrag unterschrieben wurde, um bei digitaler Signatur die Bearbeitung direkt beginnen zu können oder ggf. auf den postalischen Mantelbogen zu warten.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="bestaetigungAngaben"
                              minOccurs="0"
                              type="xfu:BestaetigungAngabenType"/>
                  <xs:element name="merkblattUVG" minOccurs="0" type="xs:boolean">
                     <xs:annotation>
                        <xs:documentation>Dokumentiert die Kenntnisnahme und Bestätigung des UVG Merkblatts.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="unterhaltsvorschussantrag.nachweisnachricht.0311">
      <xs:annotation>
         <xs:appinfo>
            <rechtsgrundlage>Rechtsgrundlage sind die Sozialgesetzbuecher aber kann je nach der jeweiligen Fachnachricht abweichen. </rechtsgrundlage>
         </xs:appinfo>
         <xs:documentation>Mit dieser Nachricht koennen Nachweise vom Portal an die zustaendige Stelle transportiert werden.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xfb:NachrichtType">
               <xs:sequence>
                  <xs:element name="nachweis" type="xfb:NachweisdokumentType">
                     <xs:annotation>
                        <xs:documentation>Hier wird Informationen zum Nachweis und der Nachweis selbst übertragen.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="zugehoerigerAntrag" type="xfb:UUIDType">
                     <xs:annotation>
                        <xs:documentation>Hier ist die UUID anzugeben, die dem Antrag zugewiesen wurde, für den dieser Nachweis erbracht wird. Gibt es mehrere Nachweisnachrichten, die zu ein und demselben Antrag gehoeren, ist bei all diesen Nachweisnachrichten dieses Element identisch zu befüllen, damit die Empfänger Antragsnachricht und Nachweise eineindeutig zuordnen können.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="gesamtZahlDerNachrichten" type="xs:nonNegativeInteger">
                     <xs:annotation>
                        <xs:documentation>Hiermit wird die Gesamtzahl der zu erwartenden Nachrichten übersandt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="artSignaturDigital" minOccurs="0" type="xs:boolean">
                     <xs:annotation>
                        <xs:documentation>Pro Antrag wird hinterlegt, welche Art der Signatur (digital oder mit Unterschriften-Seite) gewählt wurde. Beim Wert "true" handelt es sich um eine digitale Sigantur. Es ist wichtig für die Sachbearbeitung, dass im Fachverfahren eingesehen werden kann, wie der Antrag unterschrieben wurde, um bei digitaler Signatur die Bearbeitung direkt beginnen zu können oder ggf. auf den postalischen Mantelbogen zu warten.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="bestaetigungAngaben"
                              minOccurs="0"
                              type="xfu:BestaetigungAngabenType"/>
                  <xs:element name="merkblattUVG" minOccurs="0" type="xs:boolean">
                     <xs:annotation>
                        <xs:documentation>Dokumentiert die Kenntnisnahme und Bestätigung des UVG Merkblatts.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
</xs:schema>
