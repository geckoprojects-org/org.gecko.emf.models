   <xs:element name="beistandschaft.antrag.0601">
      <xs:annotation>
         <xs:appinfo>
            <rechtsgrundlage/>
         </xs:appinfo>
         <xs:documentation>Mit dieser Nachricht werden die Daten zum Antrag einer Beistandschaft strukturiert von einem Portal an die zuständigen Jugendämter versendet.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xfb:AntragsnachrichtType">
               <xs:sequence>
                  <xs:element name="anliegensklaerung" type="xfbss:AnliegensklaerungBSSType">
                     <xs:annotation>
                        <xs:documentation>In diesem Element wird geklärt, um welches Anliegen es im Antrag geht.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="antragstellenderElternteil"
                              type="xfbss:AntragstellenderElternteilType">
                     <xs:annotation>
                        <xs:documentation>Angaben zum antragstellenden Elternteil</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="angabenZumKind" type="xfbss:AngabenZumKindType">
                     <xs:annotation>
                        <xs:documentation>Angaben zum Kind.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="angabenZumAnderenElternteil"
                              minOccurs="0"
                              type="xfbss:AndererElternteilType">
                     <xs:annotation>
                        <xs:documentation>Angaben zum anderen Elternteil.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="angabenZumUnterhalt"
                              minOccurs="0"
                              type="xfbss:AngabenZumUnterhaltType">
                     <xs:annotation>
                        <xs:documentation>Die Angaben zum Unterhalt. Das Element ist nur zu befüllen, wenn für anliegenBeistandschaft u oder vu gewählt wurde.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="nachweise" minOccurs="0" type="xfbss:NachweiseBSSType"/>
                  <xs:element name="wartenAufUnterschrift" type="xs:boolean">
                     <xs:annotation>
                        <xs:documentation>Angabe, ob noch auf Unterschrit gewartet werden muss.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="dsgvo" type="xfb:DatenschutzerklaerungenType">
                     <xs:annotation>
                        <xs:documentation>Angabe, ob noch auf Unterschrit gewartet werden muss.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="richtigkeitDerAngaben" type="xs:boolean"/>
                  <xs:element name="pdfAntrag" minOccurs="0" type="xfb:NachweisdokumentType">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element ist es möglich, den Antrag im PDF anzuhängen.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="merkblattUVG" minOccurs="0" type="xs:boolean">
                     <xs:annotation>
                        <xs:documentation>Dokumentiert die Kenntnisnahme und Bestätigung des UVG Merkblatts.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
