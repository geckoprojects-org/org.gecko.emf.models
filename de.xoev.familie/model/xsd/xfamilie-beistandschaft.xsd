<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:xfbss="http://www.xoev.de/xfamilie/beistandschaft/1.3.0"
           xmlns:din91379="urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08"
           xmlns:xfb="http://www.xoev.de/xfamilie/baukasten/1.3.0"
           xmlns:xoev-code="http://xoev.de/schemata/code/1_0"
           targetNamespace="http://www.xoev.de/xfamilie/beistandschaft/1.3.0"
           version="1.3.0"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">
   <xs:annotation>
      <xs:appinfo>
         <standard>
            <nameLang>XFamilie</nameLang>
            <nameKurz>XFamilie</nameKurz>
            <nameTechnisch>xfamilie</nameTechnisch>
            <kennung>urn:xoev-de:kosit:standard:xfamilie</kennung>
            <beschreibung>Projektziel ist die elektronische Kommunikation im Familienbereich zwischen verschiedenen Behörden, Institutionen, Registern und Onlineportalen, die Daten untereinander austauschen, zu unterstützen. Der Nutzen des Projekts besteht in der Kostenreduktion und einer Verbesserung der Qualität von Daten für Familienleistungen, sowie einer Verbesserung der Interoperabilität von Akteuren im Familienbereich und weiteren Kommunikationspartner.</beschreibung>
         </standard>
         <versionStandard>
            <version>1.3.0</version>
            <beschreibung>Die Änderungshistorie befindet sich in Tabellenform nach Change Requests gegliedert in Kapitel E.</beschreibung>
            <versionXOEVProfil>3.0.2</versionXOEVProfil>
            <versionXOEVHandbuch>3.0.2</versionXOEVHandbuch>
            <versionXGenerator>3.1.0</versionXGenerator>
            <versionModellierungswerkzeug>19.0</versionModellierungswerkzeug>
            <nameModellierungswerkzeug>MagicDraw</nameModellierungswerkzeug>
         </versionStandard>
      </xs:appinfo>
   </xs:annotation>
   <xs:import schemaLocation="din-norm-91379-datatypes.xsd"
              namespace="urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08"/>
   <xs:import schemaLocation="xfamilie-baukasten.xsd"
              namespace="http://www.xoev.de/xfamilie/baukasten/1.3.0"/>
   <xs:import schemaLocation="xoev-code.xsd"
              namespace="http://xoev.de/schemata/code/1_0"/>
   <xs:complexType name="AndererElternteilType">
      <xs:sequence>
         <xs:element name="angabenZumAnderenElternteil" type="xs:boolean">
            <xs:annotation>
               <xs:documentation>Können Sie Angaben zum anderen Elternteil machen? If true: Weitere Angaben in diesem Element optional auszufüllen.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="namen" minOccurs="0" type="xfb:NameNatuerlichePersonType"/>
         <xs:element name="geburtsdaten" minOccurs="0" type="xfbss:GeburtType">
            <xs:annotation>
               <xs:documentation>Das optionale Element Geburtsstaat wird hier nicht benötigt.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="familienstand"
                     minOccurs="0"
                     type="xfb:Code.FamilienstandType">
            <xs:annotation>
               <xs:documentation>Angaben zum Familienstand: An dieser Stelle sind nur die Angaben ledig, verheiratet, geschieden, verwitwet, eingetragene Lebenspartnerschaft, aufgehobene Lebenspartnerschaft und durch Tod aufgelöste Partnerschaft zulässig.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="angabenZurAdresse" minOccurs="0" type="xs:boolean">
            <xs:annotation>
               <xs:documentation>Kennen Sie die Adresse des anderen Elternteils? If true: Adressfeld ausfüllen.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="adresse"
                     minOccurs="0"
                     type="xfb:PostalischeInlandsanschrift.BasisType"/>
         <xs:element name="erreichbarkeit"
                     minOccurs="0"
                     maxOccurs="unbounded"
                     type="xfb:ErreichbarkeitType">
            <xs:annotation>
               <xs:documentation>Angaben zur Erreichbarkeit des Elternteils.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="anerkennungVaterschaft" minOccurs="0" type="xs:boolean">
            <xs:annotation>
               <xs:documentation>Wenn bei Anliegensklärung die Codes v oder vu ausgewählt wurden: Ist der potentielle Vater des Kindes bereit die Vaterschaft anzuerkennen?</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="weitereAngabenzumAnderenElternteil"
                     minOccurs="0"
                     type="xfbss:WeitereAngabenZumAnderenElternteilType">
            <xs:annotation>
               <xs:documentation>Wenn bei der Anliegensklärung im Element anliegenBeistandschaft die Codes vu oder u enthalten sind, dann kann dieses Element optional befüllt werden.</xs:documentation>
            </xs:annotation>
         </xs:element>
      </xs:sequence>
   </xs:complexType>
   <xs:complexType name="AngabenZumKindBeendigungType">
      <xs:sequence>
         <xs:element name="nameDesKindes"
                     minOccurs="0"
                     type="xfb:NameNatuerlichePersonType"/>
         <xs:element name="geburtsdaten" minOccurs="0" type="xfb:GeburtType"/>
         <xs:element name="anschriftStimmtMitAntragstellendemElternteilUeberein"
                     type="xs:boolean"/>
         <xs:element name="kindAdresse"
                     minOccurs="0"
                     type="xfb:PostalischeInlandsanschrift.BasisType"/>
         <xs:element name="aktenzeichenVorgangsnummer"
                     minOccurs="0"
                     type="din91379:datatypeC">
            <xs:annotation>
               <xs:documentation>Aktenzeichen oder Vorgangsnummer des Beistandschaft-Antrags.</xs:documentation>
            </xs:annotation>
         </xs:element>
      </xs:sequence>
   </xs:complexType>
   <xs:complexType name="AngabenZumKindType">
      <xs:sequence>
         <xs:element name="kindBereitsGeboren" type="xs:boolean"/>
         <xs:element name="voraussichtlicherEntbindungstermin"
                     minOccurs="0"
                     type="xfb:TagesdatumType">
            <xs:annotation>
               <xs:documentation>Verpflichtende Angabe, wenn kindBereitsGeboren=false</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="nameDesKindes"
                     minOccurs="0"
                     type="xfb:NameNatuerlichePersonOhneGeburtsnameType"/>
         <xs:element name="geburtsdaten" minOccurs="0" type="xfb:GeburtType"/>
         <xs:element name="geburtenregisternummer"
                     minOccurs="0"
                     type="din91379:datatypeC"/>
         <xs:element name="kindWohnhaftBei"
                     minOccurs="0"
                     type="xfb:Code.KindWohnhaftBeiType"/>
         <xs:element name="kindLebtBeiSonstige" minOccurs="0" type="din91379:datatypeC">
            <xs:annotation>
               <xs:documentation>Wird zu einer Pflichtangabe, wenn kindLebtBei = Sonstiger Aufenthaltsort.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="ausbildungUndEinkuenfte"
                     minOccurs="0"
                     type="xfbss:AusbildungUndEinkuenfteType"/>
         <xs:element name="weitereKinderImHaushalt"
                     minOccurs="0"
                     maxOccurs="unbounded"
                     type="xs:boolean"/>
         <xs:element name="weitereKinder"
                     minOccurs="0"
                     maxOccurs="unbounded"
                     type="xfbss:WeitereKinderType"/>
      </xs:sequence>
   </xs:complexType>
   <xs:complexType name="AngabenZumUnterhaltType">
      <xs:annotation>
         <xs:documentation>Angaben zum Unterhalt.</xs:documentation>
      </xs:annotation>
      <xs:sequence>
         <xs:element name="angabenZumUnterhaltstitel"
                     type="xfbss:Code.UnterhaltstitelBestehtType">
            <xs:annotation>
               <xs:documentation>Angabe, ob ein Unterhaltstitel besteht.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="bemuehungUnterhaltszahlung" minOccurs="0" type="xs:boolean">
            <xs:annotation>
               <xs:documentation>Angabe, ob Bemühungen bzgl. Unterhalt erfolgten.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="bisherigeBemuehungen" minOccurs="0" type="din91379:datatypeC">
            <xs:annotation>
               <xs:documentation>Angabe, in welcher Form die bisherigen Bemühungen stattfanden.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="zahltBereits" type="xs:boolean">
            <xs:annotation>
               <xs:documentation>Angabe, ob der Unterhalt bereits gezahlt wird.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="hoeheZahlung" minOccurs="0" type="xs:float">
            <xs:annotation>
               <xs:documentation>Angabe, in welcher Höhe der Unterhalt gezahlt wurde.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="letzteZahlungAm" minOccurs="0" type="xfb:TagesdatumType">
            <xs:annotation>
               <xs:documentation>Angabe, an welchem Tag die letzte Zahlung erfolgte.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="regelmaessigeZahlung" type="xs:boolean">
            <xs:annotation>
               <xs:documentation>Angabe, ob regelmäßig eine Unterhaltszahlung stattfindet.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="angabenZurZahlung" minOccurs="0" type="din91379:datatypeC">
            <xs:annotation>
               <xs:documentation>Weitere Angaben zur Zahlung.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="geltendmachungUnterhaltsrueckstaende" type="xs:boolean">
            <xs:annotation>
               <xs:documentation>Angabe, ob Unterhaltsrückstände geltend gemacht wurden.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="angabeUnterhaltsrueckstaende"
                     minOccurs="0"
                     type="din91379:datatypeC">
            <xs:annotation>
               <xs:documentation>Angabe, in welcher Höhe die Unterhaltsrückstände geltend gemacht wurden.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="freiwilligerVerzichtAufUnterhalt" type="xs:boolean">
            <xs:annotation>
               <xs:documentation>Angabe, ob ein freiwilliger Verzicht auf Unterhalt stattfindet.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="unterhaltVerzichtZeitraum"
                     minOccurs="0"
                     type="din91379:datatypeC">
            <xs:annotation>
               <xs:documentation>"Bitte geben Sie an, für welchen Zeitraum Sie auf Unterhalt verzichtet haben." Das Element soll eingeblendet werden, wenn freiwilligerVerzichtAufUnterhalt = true</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="zahlung" minOccurs="0" type="xfbss:Code.ZahlungsartBSSType">
            <xs:annotation>
               <xs:documentation>Angabe, in welcher Form die Zahlung des Unterhalts erfolgt.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="bankverbindungZahlungJugendamt"
                     minOccurs="0"
                     type="xfb:BankverbindungType">
            <xs:annotation>
               <xs:documentation>Konto, auf das der Unterhalt gezahlt werden soll. Nur anzugeben, wenn bei zahlung die Zahlung über das Jugendamt erfolgen soll.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="bankverbindungDirektzahlung"
                     minOccurs="0"
                     type="xfb:BankverbindungType">
            <xs:annotation>
               <xs:documentation>Konto, auf das der Unterhalt gezahlt werden soll. Nur anzugeben, wenn bei zahlung eine Direktzahlung erfolgen soll.</xs:documentation>
            </xs:annotation>
         </xs:element>
      </xs:sequence>
   </xs:complexType>
   <xs:complexType name="AnliegensklaerungBSSType">
      <xs:annotation>
         <xs:documentation>Hier sind lediglich die Codes v, vu und u zu verwenden</xs:documentation>
      </xs:annotation>
      <xs:sequence>
         <xs:element name="anliegenBeistandschaft"
                     type="xfbss:Code.AnliegenBeistandschaftType"/>
         <xs:element name="vaterschaftAnerkannt" minOccurs="0" type="xs:boolean">
            <xs:annotation>
               <xs:documentation>Die Angabe, ob die Vaterschaft anerkannt wurde. Das Element vaterschaftAnerkannt ist nur zu befüllen, wenn für anliegenBeistandschaft u gewählt wurde.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="inhaberElterlicheSorge"
                     minOccurs="0"
                     type="xfbss:Code.InhaberElterlicheSorgeType"/>
      </xs:sequence>
   </xs:complexType>
   <xs:complexType name="AntragstellenderElternteilBeendigungType">
      <xs:sequence>
         <xs:element name="namen" type="xfb:NameNatuerlichePersonType">
            <xs:annotation>
               <xs:documentation>Namen des beantragenden Elternteils.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="geburtsdaten" type="xfb:GeburtType">
            <xs:annotation>
               <xs:documentation>Geburtsdaten des beantragenden Elternteils.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="adresse" type="xfb:PostalischeInlandsanschrift.BasisType">
            <xs:annotation>
               <xs:documentation>Adresse des beantragenden Elternteils.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="abweichendeAdresse" type="xs:boolean">
            <xs:annotation>
               <xs:documentation>Angaben, ob die Anschrift von der im Personalausweis angegebenen Anschrift abweicht. True: Optionales Element abweichendeAdressePerso befüllen</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="abweichendeAdressePerso"
                     minOccurs="0"
                     type="xfb:PostalischeInlandsanschrift.BasisType"/>
         <xs:element name="abweichendeAdresseNachweis"
                     minOccurs="0"
                     maxOccurs="unbounded"
                     type="xfb:NachweisdokumentType"/>
      </xs:sequence>
   </xs:complexType>
   <xs:complexType name="AntragstellenderElternteilType">
      <xs:sequence>
         <xs:element name="namen" type="xfb:NameNatuerlichePersonType"/>
         <xs:element name="geburtsdaten" type="xfb:GeburtType">
            <xs:annotation>
               <xs:documentation>Das optionale Element Geburtsstaat wird hier nicht benötigt.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="familienstand"
                     minOccurs="0"
                     type="xfb:Code.FamilienstandType">
            <xs:annotation>
               <xs:documentation>Angaben zum Familienstand: An dieser Stelle sind nur die Angaben ledig, verheiratet, geschieden, verwitwet, eingetragene Lebenspartnerschaft, aufgehobene Lebenspartnerschaft und durch Tod aufgelöste Partnerschaft zulässig.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="adresse" type="xfb:PostalischeInlandsanschrift.BasisType"/>
         <xs:element name="abweichendeAdresse" type="xs:boolean">
            <xs:annotation>
               <xs:documentation>Angabe, dass die Anschrift von der im Personalausweis angegebenen Anschrift abweicht.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="abweichendeAdressePerso"
                     minOccurs="0"
                     type="xfb:PostalischeInlandsanschrift.BasisType"/>
         <xs:element name="erreichbarkeit"
                     minOccurs="0"
                     maxOccurs="unbounded"
                     type="xfb:ErreichbarkeitType">
            <xs:annotation>
               <xs:documentation>Angaben zur Erreichbarkeit des Elternteils.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="oeffentlicheLeistungen"
                     minOccurs="0"
                     maxOccurs="unbounded"
                     type="xfbss:Code.BezugOeffentlicherLeistungenType">
            <xs:annotation>
               <xs:documentation>Das Element vaterschaftAnerkannt ist nur zu befüllen, wenn für anliegenBeistandschaft u oder vu gewählt wurde. Wenn hier "Sonstige Leistungen" ausgewählt wurde, ist das Ausfüllen des Elements sonstigeLeistungenBeschreibung mandatorisch.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="sonstigeLeistungenBeschreibung"
                     minOccurs="0"
                     type="din91379:datatypeC">
            <xs:annotation>
               <xs:documentation>Nur zu befüllen, wenn im optionalen Element oeffentlicheLeistungen "Sonstige Leistungen" ausgewählt wurde.</xs:documentation>
            </xs:annotation>
         </xs:element>
      </xs:sequence>
   </xs:complexType>
   <xs:complexType name="AusbildungUndEinkuenfteType">
      <xs:sequence>
         <xs:element name="kindInAusbildung" minOccurs="0" type="xs:boolean">
            <xs:annotation>
               <xs:documentation>Angabe, ob Kind in Ausbildung ist.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="ausbildungsjahr" minOccurs="0" type="xs:nonNegativeInteger">
            <xs:annotation>
               <xs:documentation>Verpflichtende Angabe, wenn kindInAusbildung = true.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="einkuenfteKind" minOccurs="0" type="xs:boolean">
            <xs:annotation>
               <xs:documentation>Hat Ihr Kind Einnahmen aus Vermögen (z. B. Miete, Pacht, Zinsen) oder sonstige Einkünfte?</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="einkuenfteArt" minOccurs="0" type="din91379:datatypeC">
            <xs:annotation>
               <xs:documentation>"einkuenfteArt" wird nur dann eingeblendet, wenn "einkuenfteKind" = true</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="kindergeld" minOccurs="0" type="xs:boolean">
            <xs:annotation>
               <xs:documentation>Angabe, ob Kindergeld bezogen wird.</xs:documentation>
            </xs:annotation>
         </xs:element>
      </xs:sequence>
   </xs:complexType>
   <xs:complexType name="Code.AnliegenBeistandschaftType">
      <xs:annotation>
         <xs:appinfo>
            <codeliste>
               <nameLang>AnliegenBeistandschaft</nameLang>
               <nameKurz>AnliegenBeistandschaft</nameKurz>
               <nameTechnisch>anliegenbeistandschaft</nameTechnisch>
               <kennung>urn:xoev-de:xfamilie:codeliste:anliegenbeistandschaft</kennung>
               <beschreibung>Die Art der Anliegen für Beistandschaft.</beschreibung>
               <herausgebernameLang>XFamilie</herausgebernameLang>
               <herausgebernameKurz>XFamilie</herausgebernameKurz>
            </codeliste>
            <versionCodeliste>
               <version>1.0</version>
               <beschreibung>Gibt die Arten der Anliegen für Beistandsschaft an. </beschreibung>
               <datumGueltigkeitAb>2022-11-01</datumGueltigkeitAb>
               <versionCodelistenHandbuch>1.2</versionCodelistenHandbuch>
            </versionCodeliste>
            <codelistenspalten>
               <code>
                  <spaltennameLang>Code</spaltennameLang>
                  <datentyp>string</datentyp>
