                          fixed="1.0"/>
         </xs:restriction>
      </xs:complexContent>
   </xs:complexType>
   <xs:complexType name="Code.EinkommenAndererElternteilType">
      <xs:annotation>
         <xs:appinfo>
            <codeliste>
               <nameLang>EinkommenAndererElternteil</nameLang>
               <nameKurz>EinkommenAndererElternteil</nameKurz>
               <nameTechnisch>einkommenandererelternteil</nameTechnisch>
               <kennung>urn:xoev-de:xfamilie:codeliste:einkommenandererelternteil</kennung>
               <beschreibung>Die Liste codiert die Einkommensarten des anderen Elternteils im Antrag zur Beistandschaft.</beschreibung>
               <herausgebernameLang>XFamilie</herausgebernameLang>
               <herausgebernameKurz>XFamilie</herausgebernameKurz>
            </codeliste>
            <versionCodeliste>
               <version>2.0</version>
               <beschreibung>[nd]</beschreibung>
