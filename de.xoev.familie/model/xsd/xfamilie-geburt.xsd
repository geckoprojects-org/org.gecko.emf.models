                              type="xfg:AngabenGesetzlicherVertreterElternteilType">
                     <xs:annotation>
                        <xs:documentation>Angaben zur gesetzlichen Vertretung der Mutter.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="angabenZumKind" type="xfg:AngabenZumKindType">
                     <xs:annotation>
                        <xs:documentation>Angaben zum Kind, für das eine gemeinsame Sorgererklärung beurkundet werden soll.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="terminwunsch"
                              minOccurs="0"
                              maxOccurs="unbounded"
                              type="xfb:TerminwunschType">
