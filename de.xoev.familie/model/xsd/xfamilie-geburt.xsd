                     </xs:annotation>
                  </xs:element>
                  <xs:element name="angabenGesetzlicherVertreterVater"
                              minOccurs="0"
                              maxOccurs="unbounded"
                              type="xfg:AngabenGesetzlicherVertreterElternteilType">
                     <xs:annotation>
                        <xs:documentation>Angaben zur gesetzlichen Vertretung des Vaters.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="angabenZurMutter" type="xfg:AngabenZumElternteil2Type">
                     <xs:annotation>
                        <xs:documentation>Angaben zur Mutter des Kindes für die gemeinsame Sorgeerklärung.</xs:documentation>
                     </xs:annotation>
