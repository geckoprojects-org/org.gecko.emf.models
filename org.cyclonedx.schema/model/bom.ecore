  <eClassifiers xsi:type="ecore:EEnum" name="EvidenceTechnique">
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
      <details key="name" value="evidenceTechnique"/>
    </eAnnotations>
    <eLiterals name="sourceCodeAnalysis" literal="source-code-analysis">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="&#xA;                        Examines the source code without executing it.&#xA;                    "/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="binaryAnalysis" value="1" literal="binary-analysis">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="&#xA;                        Examines a compiled binary through reverse engineering, typically via disassembly or bytecode reversal.&#xA;                    "/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="manifestAnalysis" value="2" literal="manifest-analysis">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="&#xA;                        Examines a package management system such as those used for building software or installing software.&#xA;                    "/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="astFingerprint" value="3" literal="ast-fingerprint">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="&#xA;                        Examines the Abstract Syntax Tree (AST) of source code or a compiled binary.&#xA;                    "/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="hashComparison" value="4" literal="hash-comparison">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="&#xA;                        Evaluates the cryptographic hash of a component against a set of pre-computed hashes of identified software.&#xA;                    "/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="instrumentation" value="5">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="&#xA;                        Examines the call stack of running applications by intercepting and monitoring application logic without the need to modify the application.&#xA;                    "/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="dynamicAnalysis" value="6" literal="dynamic-analysis">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="&#xA;                        Evaluates a running application.&#xA;                    "/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="filename" value="7">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="&#xA;                        Evaluates file name of a component against a set of known file names of identified software.&#xA;                    "/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="attestation" value="8">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="&#xA;                        A testimony to the accuracy of the identify of a component made by an individual or entity.&#xA;                    "/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="other" value="9">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="&#xA;                        Any other technique.&#xA;                    "/>
      </eAnnotations>
