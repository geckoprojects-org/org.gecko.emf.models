  <eClassifiers xsi:type="ecore:EDataType" name="Cpe" instanceClassName="java.lang.String">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="&#xA;                Define the format for acceptable CPE URIs. Supports CPE 2.2 and CPE 2.3 formats.&#xA;                Refer to https://nvd.nist.gov/products/cpe for official specification.&#xA;            "/>
    </eAnnotations>
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
      <details key="name" value="cpe"/>
      <details key="baseType" value="http://www.eclipse.org/emf/2003/XMLType#string"/>
      <details key="pattern" value="([c][pP][eE]:/[AHOaho]?(:[A-Za-z0-9\._\-~%25]*){0,6})|(cpe:2\.3:[aho\*\-](:(((\?*|\*?)([a-zA-Z0-9\-\._]|(\\[\\\*\?!&quot;#$$%25&amp;'\(\)\+,/:;&lt;=>@\[\]\^`\{\|}~]))+(\?*|\*?))|[\*\-])){5}(:(([a-zA-Z]{2,3}(-([a-zA-Z]{2}|[0-9]{3}))?)|[\*\-]))(:(((\?*|\*?)([a-zA-Z0-9\-\._]|(\\[\\\*\?!&quot;#$$%25&amp;'\(\)\+,/:;&lt;=>@\[\]\^`\{\|}~]))+(\?*|\*?))|[\*\-])){4})"/>
    </eAnnotations>
  </eClassifiers>
