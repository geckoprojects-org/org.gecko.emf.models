  <eClassifiers xsi:type="ecore:EClass" name="PedigreeType">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="&#xA;                Component pedigree is a way to document complex supply chain scenarios where components are created,&#xA;                distributed, modified, redistributed, combined with other components, etc. Pedigree supports viewing&#xA;                this complex chain from the beginning, the end, or anywhere in the middle. It also provides a way to&#xA;                document variants where the exact relation may not be known.&#xA;            "/>
    </eAnnotations>
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
      <details key="name" value="pedigreeType"/>
      <details key="kind" value="elementOnly"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="ancestors" eType="#//ComponentsType2"
        containment="true" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Describes zero or more components in which a component is derived&#xA;                        from. This is commonly used to describe forks from existing projects where the forked version&#xA;                        contains a ancestor node containing the original component it was forked from. For example,&#xA;                        Component A is the original component. Component B is the component being used and documented&#xA;                        in the BOM. However, Component B contains a pedigree node with a single ancestor documenting&#xA;                        Component A - the original component from which Component B is derived from.&#xA;                    "/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="ancestors"/>
        <details key="namespace" value="##targetNamespace"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="descendants" eType="#//ComponentsType2"
        containment="true" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Descendants are the exact opposite of ancestors. This provides a&#xA;                        way to document all forks (and their forks) of an original or root component.&#xA;                    "/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="descendants"/>
        <details key="namespace" value="##targetNamespace"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="variants" eType="#//ComponentsType2"
        containment="true" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Variants describe relations where the relationship between the&#xA;                        components are not known. For example, if Component A contains nearly identical code to&#xA;                        Component B. They are both related, but it is unclear if one is derived from the other,&#xA;                        or if they share a common ancestor.&#xA;                    "/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="variants"/>
        <details key="namespace" value="##targetNamespace"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="commits" eType="#//CommitsType"
        containment="true" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A list of zero or more commits which provide a trail describing&#xA;                        how the component deviates from an ancestor, descendant, or variant."/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="commits"/>
        <details key="namespace" value="##targetNamespace"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="patches" eType="#//PatchesType"
        containment="true" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A list of zero or more patches describing how the component&#xA;                        deviates from an ancestor, descendant, or variant. Patches may be complementary to commits&#xA;                        or may be used in place of commits."/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="patches"/>
        <details key="namespace" value="##targetNamespace"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="notes" eType="ecore:EDataType http://www.eclipse.org/emf/2003/XMLType#//String">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Notes, observations, and other non-structured commentary&#xA;                        describing the components pedigree.&#xA;                    "/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="notes"/>
        <details key="namespace" value="##targetNamespace"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="any" unique="false" upperBound="-1"
