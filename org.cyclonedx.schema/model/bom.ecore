        <details key="documentation" value="A patch which is not developed by the creators or maintainers of the software&#xA;                        being patched. Refer to https://en.wikipedia.org/wiki/Unofficial_patch"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="monkey" value="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A patch which dynamically modifies runtime behavior.&#xA;                        Refer to https://en.wikipedia.org/wiki/Monkey_patch"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="backport" value="2">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A patch which takes code from a newer version of software and applies&#xA;                        it to older versions of the same software. Refer to https://en.wikipedia.org/wiki/Backporting"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="cherryPick" value="3" literal="cherry-pick">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A patch created by selectively applying commits from other versions or&#xA;                        branches of the same software."/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
