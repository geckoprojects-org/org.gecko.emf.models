        <details key="documentation" value="The name of the license. This may include the name of a commercial or proprietary license or an open source license that may not be defined by SPDX."/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="name"/>
        <details key="namespace" value="##targetNamespace"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="text" eType="#//AttachedTextType"
        containment="true" resolveProxies="false">
