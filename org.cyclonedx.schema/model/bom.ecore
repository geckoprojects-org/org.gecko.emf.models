  <eClassifiers xsi:type="ecore:EEnum" name="TaskTypeEnum">
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
      <details key="name" value="taskTypeEnum"/>
    </eAnnotations>
    <eLiterals name="copy">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A task that copies software or data used to accomplish other tasks in the workflow."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="clone" value="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A task that clones a software repository into the workflow in order to retrieve its source code or data for use in a build step."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="lint" value="2">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A task that checks source code for programmatic and stylistic errors."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="scan" value="3">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A task that performs a scan against source code, or built or deployed components and services. Scans are typically run to gather or test for security vulnerabilities or policy compliance."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="merge" value="4">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A task that merges changes or fixes into source code prior to a build step in the workflow."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="build" value="5">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A task that builds the source code, dependencies and/or data into an artifact that can be deployed to and executed on target systems."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="test" value="6">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A task that verifies the functionality of a component or service."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="deliver" value="7">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A task that delivers a built artifact to one or more target repositories or storage systems."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="deploy" value="8">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A task that deploys a built artifact for execution on one or more target systems."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="release" value="9">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A task that releases a built, versioned artifact to a target repository or distribution system."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="clean" value="10">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A task that cleans unnecessary tools, build artifacts and/or data from workflow storage."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="other" value="11">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A workflow task that does not match current task type definitions."/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
