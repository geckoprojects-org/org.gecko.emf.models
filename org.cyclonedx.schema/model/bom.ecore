      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Licensing details describing the licensor/licensee, license type, renewal and&#xA;                        expiration dates, and other important metadata"/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="licensing"/>
        <details key="namespace" value="##targetNamespace"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="properties" eType="#//PropertiesType"
        containment="true" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Provides the ability to document properties in a name/value store.&#xA;                        This provides flexibility to include data not officially supported in the standard&#xA;                        without having to use additional namespaces or create extensions. Property names&#xA;                        of interest to the general public are encouraged to be registered in the&#xA;                        CycloneDX Property Taxonomy - https://github.com/CycloneDX/cyclonedx-property-taxonomy.&#xA;                        Formal registration is optional."/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="properties"/>
        <details key="namespace" value="##targetNamespace"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="any" unique="false" upperBound="-1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EFeatureMapEntry">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="&#xA;                        Allows any undeclared elements as long as the elements are placed in a different namespace.&#xA;                    "/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="elementWildcard"/>
        <details key="wildcards" value="##other"/>
        <details key="name" value=":6"/>
        <details key="processing" value="lax"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="acknowledgement" eType="#//LicenseAcknowledgementEnumerationType"
        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="&#xA;                    Declared licenses and concluded licenses represent two different stages in the&#xA;                    licensing process within software development. Declared licenses refer to the&#xA;                    initial intention of the software authors regarding the licensing terms under&#xA;                    which their code is released. On the other hand, concluded licenses are the&#xA;                    result of a comprehensive analysis of the project's codebase to identify and&#xA;                    confirm the actual licenses of the components used, which may differ from the&#xA;                    initially declared licenses. While declared licenses provide an upfront indication&#xA;                    of the licensing intentions, concluded licenses offer a more thorough understanding&#xA;                    of the actual licensing within a project, facilitating proper compliance and risk&#xA;                    management. Observed licenses are defined in `evidence.licenses`. Observed licenses&#xA;                    form the evidence necessary to substantiate a concluded license.&#xA;                "/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="attribute"/>
        <details key="name" value="acknowledgement"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="bomRef" eType="#//RefType4">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="&#xA;                    An optional identifier which can be used to reference the license elsewhere in the BOM.&#xA;                    Uniqueness is enforced within all elements and children of the root-level bom element.&#xA;                "/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="attribute"/>
        <details key="name" value="bom-ref"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="LicenseTypeEnum">
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
      <details key="name" value="licenseTypeEnum"/>
    </eAnnotations>
    <eLiterals name="academic">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A license that grants use of software solely for the purpose&#xA;                        of education or research."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="appliance" value="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A license covering use of software embedded in a specific&#xA;                        piece of hardware."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="clientAccess" value="2" literal="client-access">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A Client Access License (CAL) allows client computers to access&#xA;                        services provided by server software."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="concurrentUser" value="3" literal="concurrent-user">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A Concurrent User license (aka floating license) limits the&#xA;                        number of licenses for a software application and licenses are shared among&#xA;                        a larger number of users."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="corePoints" value="4" literal="core-points">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A license where the core of a computer's processor is assigned&#xA;                        a specific number of points."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="customMetric" value="5" literal="custom-metric">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A license for which consumption is measured by non-standard&#xA;                        metrics."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="device" value="6">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A license that covers a defined number of installations on&#xA;                        computers and other types of devices."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="evaluation" value="7">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A license that grants permission to install and use software&#xA;                        for trial purposes."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="namedUser" value="8" literal="named-user">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A license that grants access to the software to one or more&#xA;                        pre-defined users."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="nodeLocked" value="9" literal="node-locked">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A license that grants access to the software on one or more&#xA;                        pre-defined computers or devices."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="oem" value="10">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="An Original Equipment Manufacturer license that is delivered&#xA;                        with hardware, cannot be transferred to other hardware, and is valid for the&#xA;                        life of the hardware."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="perpetual" value="11">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A license where the software is sold on a one-time basis and&#xA;                        the licensee can use a copy of the software indefinitely."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="processorPoints" value="12" literal="processor-points">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A license where each installation consumes points per&#xA;                        processor."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="subscription" value="13">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A license where the licensee pays a fee to use the software&#xA;                        or service."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="user" value="14">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A license that grants access to the software or service by a&#xA;                        specified number of users."/>
      </eAnnotations>
    </eLiterals>
