  <eClassifiers xsi:type="ecore:EEnum" name="AggregateType">
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
      <details key="name" value="aggregateType"/>
    </eAnnotations>
    <eLiterals name="complete">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The relationship is complete. No further relationships including constituent components, services, or dependencies are known to exist."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="incomplete" value="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The relationship is incomplete. Additional relationships exist and may include constituent components, services, or dependencies."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="incompleteFirstPartyOnly" value="2" literal="incomplete_first_party_only">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The relationship is incomplete. Only relationships for first-party components, services, or their dependencies are represented."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="incompleteFirstPartyProprietaryOnly" value="3" literal="incomplete_first_party_proprietary_only">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The relationship is incomplete. Only relationships for third-party components, services, or their dependencies are represented, limited specifically to those that are proprietary."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="incompleteFirstPartyOpensourceOnly" value="4" literal="incomplete_first_party_opensource_only">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The relationship is incomplete. Only relationships for third-party components, services, or their dependencies are represented, limited specifically to those that are opensource."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="incompleteThirdPartyOnly" value="5" literal="incomplete_third_party_only">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The relationship is incomplete. Only relationships for third-party components, services, or their dependencies are represented."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="incompleteThirdPartyProprietaryOnly" value="6" literal="incomplete_third_party_proprietary_only">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The relationship is incomplete. Only relationships for third-party components, services, or their dependencies are represented, limited specifically to those that are proprietary."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="incompleteThirdPartyOpensourceOnly" value="7" literal="incomplete_third_party_opensource_only">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The relationship is incomplete. Only relationships for third-party components, services, or their dependencies are represented, limited specifically to those that are opensource."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="unknown" value="8">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The relationship may be complete or incomplete. This usually signifies a 'best-effort' to obtain constituent components, services, or dependencies but the completeness is inconclusive."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="notSpecified" value="9" literal="not_specified">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The relationship completeness is not specified."/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
