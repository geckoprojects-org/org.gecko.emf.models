  <eClassifiers xsi:type="ecore:EEnum" name="DataFlowType1">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Specifies the flow direction of the data. Valid values are:&#xA;                inbound, outbound, bi-directional, and unknown. Direction is relative to the service.&#xA;                Inbound flow states that data enters the service. Outbound flow states that data&#xA;                leaves the service. Bi-directional states that data flows both ways, and unknown&#xA;                states that the direction is not known."/>
    </eAnnotations>
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
      <details key="name" value="dataFlowType"/>
    </eAnnotations>
    <eLiterals name="inbound">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="&#xA;                        Data that enters a service.&#xA;                    "/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="outbound" value="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Data that exits a service."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="biDirectional" value="2" literal="bi-directional">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Data flows in and out of the service."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="unknown" value="3">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The directional flow of data is not known."/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
