  <eClassifiers xsi:type="ecore:EClass" name="IdentifikationNachrichtType">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Dieser Typ enthält Angaben zur eindeutigen Identifikation einer Nachricht."/>
    </eAnnotations>
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
