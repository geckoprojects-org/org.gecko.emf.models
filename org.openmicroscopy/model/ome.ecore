  <eClassifiers xsi:type="ecore:EClass" name="BinaryOnlyType">
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
      <details key="name" value="BinaryOnly_._type"/>
      <details key="kind" value="empty"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="metadataFile" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2003/XMLType#//String">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value=" Filename of the OME-XML metadata file for&#xA;                  this binary data. If the file cannot be found, a search can&#xA;                  be performed based on the UUID. "/>
      </eAnnotations>
