  <eClassifiers xsi:type="ecore:EClass" name="PlateType">
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
      <details key="name" value="Plate_._type"/>
      <details key="kind" value="elementOnly"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description" eType="#//DescriptionType4">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="&#xA;              A description for the plate.&#xA;            "/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="Description"/>
        <details key="namespace" value="##targetNamespace"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="well" upperBound="-1" eType="#//WellType"
        containment="true" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="&#xA;        A Well is a component of the Well/Plate/Screen construct to describe screening applications.&#xA;        A Well has a number of WellSample elements that link to the Images collected in this well.&#xA;        The ReagentRef links any Reagents that were used in this Well. A well is part of only one Plate.&#xA;        The origin for the row and column identifiers is the top left corner of the plate starting at zero.&#xA;        i.e The top left well of a plate is index (0,0)&#xA;      "/>
      </eAnnotations>
      <eAnnotations>
        <details key="appinfo" value="&#xA;  &lt;xsdfu>&#xA;    &lt;plural>Wells&lt;/plural>&#xA;  &lt;/xsdfu>&#xA;"/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="Well"/>
        <details key="namespace" value="##targetNamespace"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="annotationRef" upperBound="-1"
        eType="#//AnnotationRefType" containment="true" resolveProxies="false">
      <eAnnotations>
        <details key="appinfo" value="&#xA;  &lt;xsdfu>&#xA;    &lt;manytomany/>&#xA;  &lt;/xsdfu>&#xA;"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="&#xA;        The AnnotationRef element is a reference to an element derived&#xA;        from the CommonAnnotation element.&#xA;      "/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="AnnotationRef"/>
        <details key="namespace" value="##targetNamespace"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="plateAcquisition" upperBound="-1"
        eType="#//PlateAcquisitionType" containment="true" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="&#xA;        PlateAcquisition is used to describe a single acquisition run for a plate.&#xA;        This object is used to record the set of images acquired in a single&#xA;        acquisition run. The Images for this run are linked to PlateAcquisition&#xA;        through WellSample.&#xA;      "/>
      </eAnnotations>
      <eAnnotations>
        <details key="appinfo" value="&#xA;  &lt;xsdfu>&#xA;    &lt;plural>PlateAcquisitions&lt;/plural>&#xA;  &lt;/xsdfu>&#xA;"/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="PlateAcquisition"/>
        <details key="namespace" value="##targetNamespace"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="columnNamingConvention"
        eType="#//NamingConvention" unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="&#xA;            The ColumnNamingConvention&#xA;          "/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="attribute"/>
        <details key="name" value="ColumnNamingConvention"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="columns" eType="#//PositiveInt"
        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="&#xA;            The number of columns in the plate&#xA;          "/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="attribute"/>
        <details key="name" value="Columns"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="externalIdentifier" eType="ecore:EDataType http://www.eclipse.org/emf/2003/XMLType#//String">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="&#xA;            The ExternalIdentifier attribute may contain a reference to an external database.&#xA;          "/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="attribute"/>
        <details key="name" value="ExternalIdentifier"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="fieldIndex" eType="#//NonNegativeInt"
        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="&#xA;            The index of the WellSample to display as the default Field&#xA;          "/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="attribute"/>
        <details key="name" value="FieldIndex"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="iD" lowerBound="1" eType="#//PlateID">
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="attribute"/>
        <details key="name" value="ID"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2003/XMLType#//String">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="&#xA;            The Name identifies the plate to the user.&#xA;            It is used much like the ID, and so must be&#xA;            unique within the document.&#xA;&#xA;            If a plate name is not available when one is needed&#xA;            it will be constructed in the following order:&#xA;            1. If name is available use it.&#xA;            2. If not use &quot;Start time - End time&quot;&#xA;            (NOTE: Not a subtraction! A string representation&#xA;            of the two times separated by a dash.)&#xA;            3. If these times are not available use the Plate ID.&#xA;          "/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="attribute"/>
        <details key="name" value="Name"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="rowNamingConvention" eType="#//NamingConvention"
        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="&#xA;            The RowNamingConvention&#xA;          "/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="attribute"/>
        <details key="name" value="RowNamingConvention"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="rows" eType="#//PositiveInt"
        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="&#xA;            The number of rows in the plate&#xA;          "/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="attribute"/>
        <details key="name" value="Rows"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status" eType="ecore:EDataType http://www.eclipse.org/emf/2003/XMLType#//String">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="&#xA;            A textual annotation of the current state of the plate with respect to the&#xA;            experiment work-flow; e.g.&#xA;            1. Seed cell: done; 2. Transfection: done;      3. Gel doc: todo.&#xA;          "/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="attribute"/>
        <details key="name" value="Status"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="wellOriginX" eType="ecore:EDataType http://www.eclipse.org/emf/2003/XMLType#//Float"
        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="&#xA;            This defines the X position to use for the origin of the&#xA;            fields (individual images) taken in a well. It is used&#xA;            with the X in the WellSample to display the fields&#xA;            in the correct position relative to each other. Each Well&#xA;            in the plate has the same well origin. Units are set by WellOriginXUnit.&#xA;&#xA;            In the OMERO clients by convention we display the WellOrigin&#xA;            in the center of the view.&#xA;          "/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="attribute"/>
        <details key="name" value="WellOriginX"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="wellOriginXUnit" eType="#//UnitsLength"
        defaultValueLiteral="reference frame" unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The units of the well origin in X - default:reference frame."/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="attribute"/>
        <details key="name" value="WellOriginXUnit"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="wellOriginY" eType="ecore:EDataType http://www.eclipse.org/emf/2003/XMLType#//Float"
        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="&#xA;            This defines the Y position to use for the origin of the&#xA;            fields (individual images) taken in a well. It is used&#xA;            with the Y in the WellSample to display the fields&#xA;            in the correct position relative to each other. Each Well&#xA;            in the plate has the same well origin.  Units are set by WellOriginYUnit.&#xA;&#xA;            In the OMERO clients by convention we display the WellOrigin&#xA;            in the center of the view.&#xA;          "/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="attribute"/>
        <details key="name" value="WellOriginY"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="wellOriginYUnit" eType="#//UnitsLength"
        defaultValueLiteral="reference frame" unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The units of the well origin in Y - default:reference frame."/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="attribute"/>
        <details key="name" value="WellOriginYUnit"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
