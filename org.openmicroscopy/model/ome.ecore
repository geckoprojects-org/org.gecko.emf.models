        <details key="documentation" value="No binning."/>
      </eAnnotations>
      <eAnnotations>
        <details key="appinfo" value="&#xA;  &lt;xsdfu>&#xA;                &#xA;    &lt;enum compatregex=&quot;^\\s*1.*x.*1\\s*&quot; enum=&quot;ONEBYONE&quot; name=&quot;1×1&quot;/>&#xA;              &#xA;  &lt;/xsdfu>&#xA;"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="_2x2" value="1" literal="2x2">
