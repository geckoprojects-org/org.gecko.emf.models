        <details key="documentation" value="8×8 binning."/>
      </eAnnotations>
      <eAnnotations>
        <details key="appinfo" value="&#xA;  &lt;xsdfu>&#xA;                &#xA;    &lt;enum compatregex=&quot;^\\s*8.*x.*8\\s*&quot; enum=&quot;EIGHTBYEIGHT&quot; name=&quot;8×8&quot;/>&#xA;              &#xA;  &lt;/xsdfu>&#xA;"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="Other" value="4">
