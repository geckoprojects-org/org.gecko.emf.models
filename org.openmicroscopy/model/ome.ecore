        <details key="namespace" value="##targetNamespace"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="rectangle" upperBound="-2"
        eType="#//RectangleType" volatile="true" transient="true" derived="true" containment="true"
