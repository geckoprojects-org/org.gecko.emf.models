      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Describes a file location.  Can optionally specify a portion of a file using Offset and a ReadLength.&#xA;      If Offset and ReadLength are specified in conjuction with Compression, then they point into the uncompressed file.&#xA;      "/>
