        <details key="documentation" value="The units of the pin hole diameter for confocal microscopes - default:microns[µm]."/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="attribute"/>
        <details key="name" value="PinholeSizeUnit"/>
      </eAnnotations>
