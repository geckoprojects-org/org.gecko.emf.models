        <details key="namespace" value="##targetNamespace"/>
        <details key="affiliation" value="ShapeGroup"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="polyline" upperBound="-2"
        eType="#//PolylineType" volatile="true" transient="true" derived="true" containment="true"
        resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="&#xA;        The Polyline defines open shapes formed of straight&#xA;        lines. Note: Polyline uses counterclockwise winding (this is the&#xA;        default OpenGL behavior)&#xA;      "/>
      </eAnnotations>
      <eAnnotations>
        <details key="appinfo" value="&#xA;  &lt;xsdfu>&#xA;    &lt;plural>Polylines&lt;/plural>&#xA;  &lt;/xsdfu>&#xA;"/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
