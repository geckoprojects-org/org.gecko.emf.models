  <eClassifiers xsi:type="ecore:EEnum" name="Binning">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="&#xA;        Represents the number of pixels that are combined to form larger pixels. {used:CCD,EMCCD}&#xA;      "/>
    </eAnnotations>
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
      <details key="name" value="Binning"/>
