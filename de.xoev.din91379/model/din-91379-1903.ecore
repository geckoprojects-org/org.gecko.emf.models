  <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
    <details key="documentation" value="Diese Schema-Datei enthält die technische Repräsentation der in der DIN SPEC 91379 definierten Datentypen."/>
  </eAnnotations>
  <eClassifiers xsi:type="ecore:EDataType" name="DatatypeA" instanceClassName="java.lang.String">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Der Datentyp A gibt wieder, welche Schriftzeichen in hoheitlichen Dokumenten für Namen natürlicher Personen verwendet werden."/>
    </eAnnotations>
    <eAnnotations>
      <details key="appinfo" value="&#xA;              &#xA;  &lt;datentyp>&#xA;                   &#xA;    &lt;nameLang>Datentyp A&lt;/nameLang>&#xA;                   &#xA;    &lt;nameKurz>Datentyp A&lt;/nameKurz>&#xA;                   &#xA;    &lt;nameTechnisch>datatypeA&lt;/nameTechnisch>&#xA;                   &#xA;    &lt;kennung>urn:xoev-de:kosit:xoev:datentyp:din-spec-91379.datatypeA&lt;/kennung>&#xA;                   &#xA;    &lt;externeWebsite>https://www.din.de/de/wdc-beuth:din21:301228458&lt;/externeWebsite>&#xA;                &#xA;  &lt;/datentyp>&#xA;              &#xA;  &lt;versionDatentyp>&#xA;                   &#xA;    &lt;version>2019-03&lt;/version>&#xA;                   &#xA;    &lt;lizenz>Creative Commons Namensnennung - Keine Bearbeitung 4.0 International&lt;/lizenz>&#xA;                   &#xA;    &lt;bezugsort>http://www.xoev.de/de/bibliothek&lt;/bezugsort>&#xA;                &#xA;  &lt;/versionDatentyp>&#xA;           &#xA;"/>
