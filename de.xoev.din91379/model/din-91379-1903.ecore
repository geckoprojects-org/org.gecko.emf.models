  <eClassifiers xsi:type="ecore:EDataType" name="DatatypeC" instanceClassName="java.lang.String">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Der Datentyp C wurde für alle normativen Schriftzeichen der DIN SPEC entworfen. Er ist somit die technische Umsetzung der Schnittstellenvereinbarung Alle nach DIN SPEC 91379 normativen Schriftzeichen. Texte mit griechischen oder kyrillischen Buchstaben oder mit erweiterten (nicht-normativen) Nicht-Buchstaben sind unzulässig."/>
    </eAnnotations>
    <eAnnotations>
      <details key="appinfo" value="&#xA;              &#xA;  &lt;datentyp>&#xA;                   &#xA;    &lt;nameLang>Datentyp C&lt;/nameLang>&#xA;                   &#xA;    &lt;nameKurz>Datentyp C&lt;/nameKurz>&#xA;                   &#xA;    &lt;nameTechnisch>datatypeC&lt;/nameTechnisch>&#xA;                   &#xA;    &lt;kennung>urn:xoev-de:kosit:xoev:datentyp:din-spec-91379.datatypeC&lt;/kennung>&#xA;                   &#xA;    &lt;externeWebsite>https://www.din.de/de/wdc-beuth:din21:301228458&lt;/externeWebsite>&#xA;                &#xA;  &lt;/datentyp>&#xA;              &#xA;  &lt;versionDatentyp>&#xA;                   &#xA;    &lt;version>2019-03&lt;/version>&#xA;                   &#xA;    &lt;lizenz>Creative Commons Namensnennung - Keine Bearbeitung 4.0 International&lt;/lizenz>&#xA;                   &#xA;    &lt;bezugsort>http://www.xoev.de/de/bibliothek&lt;/bezugsort>&#xA;                &#xA;  &lt;/versionDatentyp>&#xA;           &#xA;"/>
    </eAnnotations>
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
