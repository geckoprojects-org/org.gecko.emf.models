  </eClassifiers>
  <eClassifiers xsi:type="ecore:EDataType" name="DatatypeE" instanceClassName="java.lang.String">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Dieser Datentyp kann nur von solchen IT-Verfahren unterstützt werden, die auch die nicht-normativen Schriftzeichen der Norm DIN 91379 unterstützen. Der Datentyp E wurde für alle normativen und erweiterten Schriftzeichen der DIN-Norm entworfen. Ein Einsatzgebiet dieses Datentyps kann der grenzüberschreitende Datenaustausch sein, wenn auch griechische und kyrillische Buchstaben benötigt werden. Er ist somit die technische Umsetzung der Schnittstellenvereinbarung Alle nach Norm DIN 91379 normativen und nicht-normativen Schriftzeichen. Texte mit Buchstaben oder Nicht-Buchstaben, die in der DIN-Norm nicht enthalten sind, wie z. B. asiatische oder arabische Buchstaben, sind unzulässig."/>
    </eAnnotations>
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
      <details key="name" value="datatypeE"/>
      <details key="baseType" value="http://www.eclipse.org/emf/2003/XMLType#string"/>
    </eAnnotations>
  </eClassifiers>
</ecore:EPackage>
