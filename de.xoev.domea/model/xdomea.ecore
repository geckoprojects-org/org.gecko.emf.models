    <eStructuralFeatures xsi:type="ecore:EReference" name="sGOTyp" eType="#//SchriftgutobjekttypCodeType"
        containment="true" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Der Typ des Schriftgutobjektes, auf das verwiesen wird. Mögliche Werte sind &quot;Akte&quot;, &quot;Dokument&quot; und &quot;Vorgang&quot;."/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="SGOTyp"/>
        <details key="namespace" value="##targetNamespace"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="sGOKennzeichen" eType="ecore:EDataType http://www.eclipse.org/emf/2003/XMLType#//String">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Das Kennzeichen des Schriftgutobjektes, auf das verwiesen wird."/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="SGOKennzeichen"/>
