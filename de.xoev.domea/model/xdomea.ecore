    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="dokumentOderDokumentMitSchriftstueck"
        upperBound="-1" eType="#//DokumentOderDokumentMitSchriftstueckType" containment="true"
        resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Ein Dokument, das hierarchisch in die Akte eingebunden bzw. der Akte untergeordnet ist."/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="DokumentOderDokumentMitSchriftstueck"/>
