      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Die Rolle des Kontakts, z. B. Antragsteller, Zustellungsbevollmächtigter, Gutachter, im konkreten Geschäftsprozess als Text."/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
