  <eClassifiers xsi:type="ecore:EClass" name="FormatType">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Ein Format gibt die Syntax und Semantik einer Datei (z. B. Primärdokument, Aktenplandatei) an."/>
