  <eClassifiers xsi:type="ecore:EClass" name="NkNichtFVDatenEinLeserMitEmpfangsbestaetigungType"
      eSuperTypes="#//NachrichtType">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Der Kopf der Nachricht enthält allgemeine Informationen für den Leser einer Nachricht, bei der es sich nicht um eine Empfangs-/Importnachricht auf eine andere Nachricht handelt, die einen Leser besitzt und mit der eine Empfangsbestätigung angefordert werden kann."/>
    </eAnnotations>
    <eAnnotations>
      <details key="appinfo" value="&#xA;              &#xA;  &lt;title>NkNichtFVDatenEinLeserMitEmpfangsbestaetigung&lt;/title>&#xA;           &#xA;"/>
    </eAnnotations>
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
      <details key="name" value="NkNichtFVDatenEinLeserMitEmpfangsbestaetigungType"/>
      <details key="kind" value="elementOnly"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="empfangsbestaetigung" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2003/XMLType#//Boolean"
        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Die Angabe, ob vom Leser der Nachricht eine Empfangsbestätigung angefordert wird. Eine angeforderte Empfangsbestätigung wird mit &quot;1&quot; gekennzeichnet. Wird keine Empfangsbestätigung angefordert, so wird dies mit &quot;0&quot; gekennzeichnet. Der Leser ist bei angeforderter Empfangsbestätigung aber nicht verpflichtet, eine Empfangsbestätigung zu versenden."/>
      </eAnnotations>
      <eAnnotations>
        <details key="appinfo" value="&#xA;                          &#xA;  &lt;implementationHint>Für die Umsetzung in den Systemen wird empfohlen, sofern kein anderer Wert hinterlegt wurde, als Standardwert den Wert &quot;0&quot; für &quot;keine Empfangsbestätigung senden&quot; anzugeben.&lt;/implementationHint>&#xA;                       &#xA;"/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="Empfangsbestaetigung"/>
        <details key="namespace" value="##targetNamespace"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
