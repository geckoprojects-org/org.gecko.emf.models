  <eClassifiers xsi:type="ecore:EClass" name="HashType">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Informationen zum Überprüfen eventuell nicht dokumentierter oder nicht berechtigter Änderungen am Objekt. Diese Angaben werden durch das Speichersystem automatisch berechnet und aufgezeichnet. Durch den Abgleich des Hash-Wertes bei der Übernahme in das empfangende System kann sichergestellt werden, dass empfangene und gesendete Dateien identisch sind. Es ist entweder das Element Algorithmus oder das Element SonstigerAlgorithmus zu befüllen."/>
    </eAnnotations>
    <eAnnotations>
      <details key="appinfo" value="&#xA;              &#xA;  &lt;title>Hash&lt;/title>&#xA;           &#xA;"/>
