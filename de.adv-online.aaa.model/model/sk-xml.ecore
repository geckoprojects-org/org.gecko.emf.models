  <eClassifiers xsi:type="ecore:EClass" name="DesignRuleType1" eSuperTypes="#//ElementType1">
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
      <details key="name" value="DesignRuleType"/>
      <details key="kind" value="elementOnly"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="positionierungsregel" eType="ecore:EDataType http://www.eclipse.org/emf/2003/XMLType#//String">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Das Property &quot;positionierungsregel&quot; dient zur Aufnahme der in den bisherigen Signaturkatalogen verwendeten Positionierungsregeln. Es stellt die Verbindung zu den Präsentationsobjekten her, welche auf die Positionierungsregel Bezug nehmen."/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="positionierungsregel"/>
        <details key="namespace" value="##targetNamespace"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="rulesToConsider" upperBound="-1"
        eType="#//RulesToConsiderType" containment="true" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Diese Rolle an DesignRule modelliert die im Alt-SK angegebenen &quot;zusätzlich zu beachtenden&quot; Positionierungsregeln, Beim Übergang auf PlacementRules sollen diese Verweise aufgelöst werden und die Sachverhalte ausschließlich mittels der PlacementRules in exakterer Art dargestellt werden."/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="rulesToConsider"/>
        <details key="namespace" value="##targetNamespace"/>
      </eAnnotations>
    </eStructuralFeatures>
