  <eClassifiers xsi:type="ecore:EEnum" name="BoundaryOverlapTreatmentType">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Die Werte dieses Typs steuern, wie bei einer Flächenfüllung mit Graphics bei Überlappung mit dem Rand zu verfahren ist.&#xA;Beim Wert &quot;clip&quot; soll das Graphics am Rand abgeschnitten werden. &#xA;Beim Wert &quot;omit&quot; soll das Graphics in diesem Falle ganz weggelassen werden."/>
    </eAnnotations>
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
      <details key="name" value="BoundaryOverlapTreatmentType"/>
    </eAnnotations>
    <eLiterals name="clip">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Am Flächenrand angeschnittene Graphics sind am Rand abzuschneiden."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="omit" value="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Am Rand angeschnittene Graphics sind ganz wegzulassen."/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
