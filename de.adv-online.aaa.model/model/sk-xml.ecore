  <eClassifiers xsi:type="ecore:EClass" name="PointsOnLinePropertyType">
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
      <details key="name" value="PointsOnLinePropertyType"/>
