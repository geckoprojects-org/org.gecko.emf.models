        eType="#//PlacementType" containment="true" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Geordnete Liste von PlacementRules, die exakt in dieser vorgegebenen Reihenfolge zur Anwendung gebracht werden.&#xA; &#xA;Default: &quot;&quot;"/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
