  <eClassifiers xsi:type="ecore:EClass" name="SomePropertyType">
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
      <details key="name" value="SomePropertyType"/>
      <details key="kind" value="elementOnly"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="some" eType="#//SomeType"
        containment="true" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Objekte der Klasse &quot;Some&quot; stehen für eine existenzquantifizierte Aussage über einen Ausdruck, der eine Menge bezeichnet.&#xA;&#xA;Die Aussage ist dabei: Es gibt ein Element in der durch &quot;in&quot; bezeichneten Menge/Sequenz, welches den Ausdruck, der unter &quot;satisfies&quot; angegeben ist, erfüllt. Dabei wird das laufende Element durch die Variable &quot;variable&quot; bezeichnet.&#xA;&#xA;Der Kontext wird durch das Some-Objekt nicht verändert, d.h. SelfStep hat zu Beginn beider Ausdrücke dieselbe Bedeutung wie außerhalb des &quot;Some&quot;.&#xA;&#xA;In XPath entspricht &quot;Some&quot; dem Konstrukt:&#xA;&#xA;some $var in expr1 satisfies expr2"/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="Some"/>
        <details key="namespace" value="##targetNamespace"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="actuate" eType="ecore:EEnum ../../org.w3.xlink.model/model/xlink.ecore#//ActuateType"
        unsettable="true">
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="attribute"/>
