      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Das Property &quot;miterlimit&quot; wirkt bei linejoin=miter und begrenzt die Länge einer Gehrungsspitze an einem spitzen Winkel. &#xA;&#xA;&quot;miterlimit&quot; wird als Verhältnis der Länge der Gehrungsspitze zur Linienbreite (&quot;width&quot;) angegeben. &#xA;&#xA;Standardwert ist 4.0."/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
