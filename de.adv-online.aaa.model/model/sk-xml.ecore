        <details key="documentation" value="Der Mengen-/Sequenzausdruck im For-Konstrukt. Dies ist eine der wenigen Stellen im Ausdruckskalkül, wo multiple Werte erlaubt sind."/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
