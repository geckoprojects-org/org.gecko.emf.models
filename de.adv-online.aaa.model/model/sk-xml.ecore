  <eClassifiers xsi:type="ecore:EClass" name="FilterType1" eSuperTypes="#//ElementType1">
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
      <details key="name" value="FilterType"/>
      <details key="kind" value="elementOnly"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="geometryType" eType="#//GeometryTypeType"
        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Geometrietyp mit den möglichen Werten point, curve, surface.&#xA;&#xA;Der Geometrietyp ist optional. Er kann bei der Selektion von REOs als zusätzliches Kriterium neben &quot;featureTypeName&quot; und &quot;modelClass&quot; angegeben werden, um eine Einschränkung auf Features des angegebenen Geometrietyps im &quot;position&quot;-Property zu erzielen. &#xA;&#xA;Bei ZUSOs und NREOs kann der Geometrietyp nicht angegeben werden. Wird er bei REOs nicht angegeben, so erfolgt keine Filterung nach Geometrietyp."/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="geometryType"/>
        <details key="namespace" value="##targetNamespace"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="modelClass" unique="false"
        upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2003/XMLType#//String">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Modellart, entsprechend dem AAA-Schema.&#xA;&#xA;Um diese Paketreferenz in das AAA-Fachschema nicht bis in SK-XML und MDL durchschlagen zu lassen, wird der Typ AA_Modellart in beiden abgeleiteten Modellen wie ein CharacterString behandelt.&#xA;&#xA;Das &quot;modelClass&quot;-Attribut kann multipel angegeben oder auch ganz weggelassen werden. Wenn das Attribut fehlt, so wird die Modellart durch den Filter nicht überprüft. Ansonsten lässt der Filter nur die angegebenen Modellarten zu."/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="modelClass"/>
        <details key="namespace" value="##targetNamespace"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="featureTypeName" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2003/XMLType#//QName">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Namensraumbehaftete Objektart, z.B. AX_Strassenachse im Namensraum &lt;a href=&quot;http://www.adv-online.de/namespaces/adv/gid/6.0&quot;>&lt;font color=&quot;#0000ff&quot;>&lt;u>http://www.adv-online.de/namespaces/adv/gid/6.0&lt;/u>&lt;/font>&lt;/a>."/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="featureTypeName"/>
        <details key="namespace" value="##targetNamespace"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="featureTypeNumber" eType="ecore:EDataType http://www.eclipse.org/emf/2003/XMLType#//String">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Objektartnummer, z.B. 42003.&#xA;&#xA;Diese Angabe ist nicht unbedingt erforderlich, da sie sich aus der Objektart (featureTypeName) ergibt.&#xA;&#xA;Die Objektartnummer ist zwar eine Zahl, wurde aber als Text modelliert, um auszudrücken, dass führende Nullen Teil der Nummer sind."/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="featureTypeNumber"/>
        <details key="namespace" value="##targetNamespace"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="basicObjectType" eType="#//BasicObjectTypeType"
        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Der Objekttyp, &quot;reo&quot; oder &quot;zuso&quot;.&#xA;&#xA;Diese Angabe ist nicht unbedingt erforderlich, da sie sich aus der Objektart (featureTypeName) ergibt."/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="basicObjectType"/>
        <details key="namespace" value="##targetNamespace"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="expression" eType="#//ExpressionType"
        containment="true" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Die Rolle &quot;expression&quot; liefert einen logischen Ausdruck, der definiert, ob das laufende Objekt zugelassen wird oder nicht. Der Defaultwert ist 'true'."/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="expression"/>
        <details key="namespace" value="##targetNamespace"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
