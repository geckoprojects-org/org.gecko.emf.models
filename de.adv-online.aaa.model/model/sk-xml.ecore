  <eClassifiers xsi:type="ecore:EEnum" name="RelativeRotationType">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Der Aufzählungstyp RelativeRotation enthält die möglichen Optionen für die Ausrichtung von Graphics entlang des Linienverlaufs."/>
    </eAnnotations>
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
      <details key="name" value="RelativeRotationType"/>
    </eAnnotations>
    <eLiterals name="none">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Die Graphics werden ohne weitere Drehung platziert."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="tangential" value="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Die Graphics werden so gedreht, dass ihre ursprünglich nach oben weisende Achse tangential entlang der Linie verläuft."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="normal" value="2">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Die Graphics werden so gedreht, dass ihre ursprünglich nach oben weisende Achse in Richtung der linksseitigen Normalen zeigt."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="antiNormal" value="3">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Die Graphics werden so gedreht, dass ihre ursprünglich nach oben weisende Achse in Richtung der rechtsseitigen Normalen zeigt."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="alternatingNormal" value="4">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Die Graphics werden so gedreht, dass ihre ursprünglich nach oben weisende Achse im Verlauf der Linie abwechselnd in Richtung der linksseitigen Normalen und der rechtseitigen Normalen zeigt."/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EDataType" name="RelativeRotationTypeObject" instanceClassName="org.eclipse.emf.common.util.Enumerator">
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
      <details key="name" value="RelativeRotationType:Object"/>
      <details key="baseType" value="RelativeRotationType"/>
    </eAnnotations>
  </eClassifiers>
