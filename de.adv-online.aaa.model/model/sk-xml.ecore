  <eClassifiers xsi:type="ecore:EEnum" name="AdjustmentType">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Der Aufzählungtyp Adjustment liefert Optionen für den Ausgleich von Linienmustern entlang der Geomentrie."/>
    </eAnnotations>
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
      <details key="name" value="AdjustmentType"/>
