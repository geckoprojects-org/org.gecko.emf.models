  <eClassifiers xsi:type="ecore:EClass" name="GraphicType3" abstract="true" eSuperTypes="#//ElementType1">
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
      <details key="name" value="GraphicType"/>
      <details key="kind" value="elementOnly"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="displacementX" eType="ecore:EDataType http://www.eclipse.org/emf/2003/XMLType#//Double"
        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Verschiebung eines Graphic in X-Richtung. &#xA;&#xA;Die Einheit wird bestimmt durch den mapLengthFactor, Default: mm/100."/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="displacementX"/>
        <details key="namespace" value="##targetNamespace"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="displacementY" eType="ecore:EDataType http://www.eclipse.org/emf/2003/XMLType#//Double"
        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Verschiebung eines Graphic in Y-Richtung, &#xA;&#xA;Die Einheit wird bestimmt durch den mapLengthFactor, Default: mm/100."/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="displacementY"/>
        <details key="namespace" value="##targetNamespace"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="rotation" eType="ecore:EDataType http://www.eclipse.org/emf/2003/XMLType#//Double"
        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Das rotation-Attribut steuert die Drehung eines Graphic gegenüber seiner Definition. Die Drehung erfolgt um den Ursprung der Definition und wird im Gegenuhrzeigersinn entsprechend dem &quot;mapAngleFactor&quot; angegeben. Default ist die Angabe im Bogenmaß.&#xA;&#xA;Fehlt das Attribut, so wird 0.0 angenommen. &#xA;&#xA;Wird die Darstellung eines Präsentationsobjekts beschrieben -erkennbar am featureTypeName des Filter-Objekts - so gilt folgende Sonderfunktionalität: Enthält dieses Objekt eine Drehung (Attribut &quot;drehwinkel&quot;), so überschreibt diese die Angabe im rotation-Attribut."/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="rotation"/>
        <details key="namespace" value="##targetNamespace"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="scalefactor" eType="ecore:EDataType http://www.eclipse.org/emf/2003/XMLType#//Double"
        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Das scalefactor-Attribut steuert die Skalierung (Vergrößerung/Verkleinerung) eines Graphic gegenüber seiner Definition. Die Skalierung erfolgt um den Ursprung der Definition. Sie wird angegeben als Skalierungsfaktor. Fehlt das Attribut wird 1.0 angenommen.&#xA;&#xA;Wird die Darstellung eines Präsentationsobjekts beschrieben - erkennbar am featureTypeName des Filter-Objekts - so gilt folgende Sonderfunktionalität: Enthält dieses Objekt eine Skalierung (Attribut &quot;skalierung&quot;), so überschreibt diese die Angabe im scalefactor-Attribut."/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="scalefactor"/>
        <details key="namespace" value="##targetNamespace"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="halo" eType="#//HaloType2"
        containment="true" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Die für ein Graphic wirksame Halo-Definition."/>
