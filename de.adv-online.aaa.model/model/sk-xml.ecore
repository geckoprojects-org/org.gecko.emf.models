    <eStructuralFeatures xsi:type="ecore:EAttribute" name="selmode" eType="#//NeighborSelModeType"
        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Das Attribut steuert, wie die Auswahl der Nachbarn als Geometrie umgesetzt werden soll.&#xA;&#xA;Der Wert &quot;selected&quot; fordert, dass genau die Begrenzungslinien zu den ausgewählten Nachbarn zum Zuge kommen.&#xA;&#xA;&quot;notSelected&quot; bestimmt, dass genau die anderen Begrenzungslinien herangezogen werden.&#xA;&#xA;&quot;noNeighbor&quot; verlangt, die Ausgabe der Randgeometrien, bei denen kein Nachbar vorliegt. Dies ist vom &quot;neighborhoodFilter&quot; unabhängig, der deshalb auch nicht angegeben werden muss.&#xA;&#xA;Bei Auslassung gilt &quot;selected&quot;."/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="selmode"/>
        <details key="namespace" value="##targetNamespace"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="neighborhoodFilter" eType="#//NeighborhoodFilterType"
        containment="true" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Der referierte Filter wählt unter den direkten Nachbarn eines auszugebenden Flächenobjekts aus. Letzteres ist im Filter über die Variable $emit sichtbar.&#xA;&#xA;Bei Auslassung werden alle Nachbarn gewählt."/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="neighborhoodFilter"/>
        <details key="namespace" value="##targetNamespace"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="RelateType">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Die Aufzählungswerte im Typ Relate erlauben die Auswahl zwischen verschiedenen Arten der geometrischen Verschneidung."/>
    </eAnnotations>
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
