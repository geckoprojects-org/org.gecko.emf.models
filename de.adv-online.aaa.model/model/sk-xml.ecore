    <eStructuralFeatures xsi:type="ecore:EAttribute" name="roundedCornerRadius" eType="ecore:EDataType http://www.eclipse.org/emf/2003/XMLType#//Double"
        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Radius für abgerundete Ecken.  Die Semantik ist analog zu SVG &quot;rect rx=...&quot;. Unterschiedliche Radien in X und Y sind nicht zugelassen, d.h. es handelt sich immer um Viertelkreise.&#xA;&#xA;Die Angabe erfolgt in der durch &quot;mapLengthFactor&quot; vorgegebenen Einheit (Default: mm/100)&#xA;&#xA;Default ist 0, was &quot;ohne Rundung&quot; bedeutet."/>
