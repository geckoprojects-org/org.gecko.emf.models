  <eClassifiers xsi:type="ecore:EClass" name="VariantGeometryType" eSuperTypes="#//PlacementRuleType">
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
      <details key="name" value="VariantGeometryType"/>
      <details key="kind" value="elementOnly"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="mode" eType="#//GeometryUnionType"
        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Wenn die angegebene Expression bei VariantGeometry eine Menge von Geometrien selektiert, so kann durch das Attribut &quot;mode&quot; eingestellt werden, wie die Aggregation der Einzelgeometrien erfolgen soll. &#xA;&#xA;Der Defaultwert &quot;standardOrUnion&quot; steht für die Übernahme der Geometrie, wenn die Menge nur ein Element enthält, und für die Vereinigung der Geometrien sonst. &#xA;&#xA;Der Sonderwert &quot;AP_Darstellung&quot; bei &quot;mode&quot; ist eine Abkürzung für die Expression &quot;dientZurDarstellungVonPosition&quot;. In diesem Fall entfällt die Expression."/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="mode"/>
        <details key="namespace" value="##targetNamespace"/>
      </eAnnotations>
