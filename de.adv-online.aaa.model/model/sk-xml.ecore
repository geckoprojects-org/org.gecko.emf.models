    <eStructuralFeatures xsi:type="ecore:EAttribute" name="perpendicularOffset" eType="ecore:EDataType http://www.eclipse.org/emf/2003/XMLType#//Double"
        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Verschiebung des Texts senkrecht zur Linie in einem LineLabel.&#xA;&#xA;Bei 0 oder Weglassen erfolgt keine Verschiebung. Der Text wird entstprechend dem verticalAlignment entlang der Linie positioniert.&#xA;&#xA;Ansonsten verschieben positive Werte nach links  und negative nach rechts. Bei Flächen bedeutet &quot;nach links&quot; ins Innere der Fläche und &quot;nach rechts&quot; ins Äußere der Fläche.&#xA;Einheit ist die durch &quot;mapLengthFactor&quot; vorgegebene (Default: mm/100)."/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="perpendicularOffset"/>
        <details key="namespace" value="##targetNamespace"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="LinePlacedGraphicPropertyType">
