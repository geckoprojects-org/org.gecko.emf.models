  <eClassifiers xsi:type="ecore:EEnum" name="TextDecorationType">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="TextDecoration ist ein Aufzählungstyp, welcher die zusätzliche Gestaltung des Textes durch Linien steuert, also z.B. Unterstreichung."/>
    </eAnnotations>
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
      <details key="name" value="TextDecorationType"/>
    </eAnnotations>
    <eLiterals name="none">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Keine Modifikation des Textes."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="underline" value="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Der Text ist zu unterstreichen."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="lineThrough" value="2">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Der Text ist durchzustreichen."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="overline" value="3">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Der Text wird mit einer Linie versehen, die über dem Text verläuft."/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
