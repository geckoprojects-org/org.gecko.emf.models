  <eClassifiers xsi:type="ecore:EClass" name="PointsOnLineType" eSuperTypes="#//PlacementRuleType">
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
      <details key="name" value="PointsOnLineType"/>
      <details key="kind" value="elementOnly"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="pattern" lowerBound="1"
        eType="#//PatternType">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Muster für die Punktplatzierung: Ein Wert von 0.0 steht für ein Symbol, Werte >0 geben den Abstand zum nächsten Eintrag vor.&#xA;&#xA;&quot;pattern&quot; wird im SK-XML als Liste dargestellt und nicht durch ein multipel auftretendes Property."/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="pattern"/>
        <details key="namespace" value="##targetNamespace"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="relativeRotation" eType="#//RelativeRotationType"
        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Durch das Property &quot;relativeRotation&quot; wird die relative Drehung des Punkts zur Linie gesteuert. Fehlt das Property, so wird der Wert &quot;none&quot; angenommen.&#xA;&#xA;Zur Bedeutung siehe die Beschreibung bei RelativeRotation."/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="relativeRotation"/>
        <details key="namespace" value="##targetNamespace"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="adjustment" eType="#//AdjustmentType"
        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Duch &quot;adjustment&quot; kann der Ausgleich des Musters in der Gesamtgeometrie (ohne die Lücken am Anfang und Ende) gefordert werden.&#xA;&#xA;Um den Ausgleich herzustellen, werden die Lücken gleichmäßig verlängert bzw. verkürzt."/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="adjustment"/>
        <details key="namespace" value="##targetNamespace"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="preGap" eType="ecore:EDataType http://www.eclipse.org/emf/2003/XMLType#//Double"
        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Lücke am Anfang der Linie, Angabe in Einheiten des &quot;mapLengthFactor&quot;.&#xA;&#xA;Default: Ohne Lücke."/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="preGap"/>
        <details key="namespace" value="##targetNamespace"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="postGap" eType="ecore:EDataType http://www.eclipse.org/emf/2003/XMLType#//Double"
        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Lücke am Ende der Linie, Angabe in Einheiten des &quot;mapLengthFactor&quot;.&#xA;&#xA;Default: Ohne Lücke."/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="postGap"/>
        <details key="namespace" value="##targetNamespace"/>
      </eAnnotations>
