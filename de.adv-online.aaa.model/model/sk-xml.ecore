    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="then" lowerBound="1" eType="#//ThenType"
        containment="true" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Der Ausdruck, der als Wert des &quot;If&quot; eingesetzt wird, falls &quot;condition&quot; zu &quot;true&quot; auswertet.&#xA;&#xA;Es ist an dieser Stelle auch eine Menge/Sequenz erlaubt. Der Typ der Elemente oder des Asudrucks selbst muss mit dem bei &quot;else&quot; übereinstimmen."/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="then"/>
        <details key="namespace" value="##targetNamespace"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="else" lowerBound="1" eType="#//ElseType"
        containment="true" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Der Ausdruck, der als Wert des &quot;If&quot; eingesetzt wird, falls &quot;condition&quot; zu &quot;false&quot; auswertet.&#xA;&#xA;Es ist an dieser Stelle auch eine Menge/Sequenz erlaubt. Der Typ der Elemente oder des Asudrucks selbst muss mit dem bei &quot;then&quot; übereinstimmen."/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="else"/>
        <details key="namespace" value="##targetNamespace"/>
      </eAnnotations>
    </eStructuralFeatures>
