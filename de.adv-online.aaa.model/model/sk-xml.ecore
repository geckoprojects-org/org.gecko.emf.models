      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="stroke" lowerBound="1"
        eType="#//StrokeType5" changeable="false" volatile="true" transient="true"
        derived="true" containment="true" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Die abstrakte Klasse Stroke enthält die Definition für die Signaturierung einer Liniengeometrie.&#xA;&#xA;Allen Stroke-Definitionen gemeinsam ist die mögliche Angabe von Lücken am Anfang und Ende der Linie. Zusätzlich kann bei allen Strokes noch ein Graphic am Anfang und am Ende der Linie platziert werden.&#xA;&#xA;Die Ausgabe der Graphics am Anfang und Ende erfolgt nach der Ausgabe aller anderen Teile der Linie."/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
