    <eStructuralFeatures xsi:type="ecore:EAttribute" name="hatchRayDirectionX" eType="ecore:EDataType http://www.eclipse.org/emf/2003/XMLType#//Double"
        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="X-Wert des Vektors, der die Schraffenrichtung angibt. Defaultwert ist 1. &#xA;&#xA;Die Länge des Vektors ist irrelevant.&#xA;&#xA;Die Schraffe erstreckt sich auch in die negative Richtung."/>
